-- Game module access follows the paths found in the provided client export.
-- We only require modules already present in the live place, and validate the API.
local moduleCache = {}
local function gameModule(root, ...)
	local path = table.pack(...)
	local key = tostring(root) .. ":" .. table.concat(path, ".")
	if moduleCache[key] then return moduleCache[key] end
	local object = root
	for i = 1, path.n do
		object = object and object:FindFirstChild(path[i])
	end
	if not object or not object:IsA("ModuleScript") then error("Game module missing: " .. table.concat(path, ".")) end
	local ok, result = pcall(require, object)
	if not ok or type(result) ~= "table" then error("Game module unavailable: " .. table.concat(path, ".")) end
	moduleCache[key] = result
	return result
end
clientModule = function(name)
	return gameModule(localPlayer, "PlayerScripts", "Client", "Controllers", name)
end
local function sharedModule(name) return gameModule(replicatedStorage, "Shared", name) end
local function configModule(name) return gameModule(replicatedStorage, "Config", name) end
local function playerData()
	local data = clientModule("DataController"):GetPlayerData()
	if type(data) ~= "table" then error("Player data not ready") end
	return data
end
local function doCall(name, ...)
	local ok, result = callRemote(name, false, ...)
	if not ok then error(tostring(result)) end
	if type(result) ~= "table" or result.Ok ~= true then error(name .. ": unexpected response; stopped") end
	return result
end

-- No worker is allowed to overlap itself, even across quick off/on transitions.
local workers = {}
local function periodic(name, interval, callback, setup)
	TemplateHub.featureCallbacks[name] = function(enabled)
		if not enabled then return true end
		if workers[name] then return false, "Previous " .. name .. " call is still finishing" end
		if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
		local context
		if setup then
			local ok, value = pcall(setup)
			if not ok then return false, tostring(value) end
			context = value
		end
		workers[name] = true
		task.spawn(function()
			local ok, message = xpcall(function()
				while TemplateHub.active and TemplateHub.values[name] do
					callback(context)
					if not waitEnabled(name, type(interval) == "function" and interval() or interval) then break end
				end
			end, function(err) return tostring(err) end)
			workers[name] = nil
			if not ok and TemplateHub.active then
				TemplateHub.setters[name](false)
				TemplateHub.report(name .. " stopped: " .. message, true)
			end
		end)
		return true
	end
end

