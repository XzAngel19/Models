---Find a captured remote without loading game modules.
local function findRemote(name)
	if game.PlaceId ~= GAME_PLACE_ID then return nil, "Join Throw Food for Animals first." end
	local folder = replicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild(name)
	if not remote or remote.ClassName ~= remoteTypes[name] then
		return nil, name .. " missing or class changed"
	end
	return remote
end

---Make a captured call; unknown responses are not treated as verified success.
local function callRemote(name, allowInactive, ...)
	if not TemplateHub.active and not allowInactive then return false, "Menu closed" end
	local remote, reason = findRemote(name)
	if not remote then return false, reason end
	if remoteBusy[name] then return false, name .. " is already in flight" end
	remoteBusy[name] = true
	local args = table.pack(...)
	local ok, result = pcall(function()
		if remote.ClassName == "RemoteEvent" then
			remote:FireServer(table.unpack(args, 1, args.n))
			return nil
		end
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	remoteBusy[name] = nil
	if not ok then return false, name .. ": " .. tostring(result) end
	if type(result) == "table" and result.Ok == false then
		return false, name .. " rejected: " .. tostring(result.Reason or result.Message or result.Error or "Ok=false")
	end
	return true, result
end

---Wait in short intervals so an automation toggle can stop its worker.
local function waitEnabled(name, seconds)
	local deadline = os.clock() + seconds
	while TemplateHub.active and TemplateHub.values[name] and os.clock() < deadline do
		task.wait(math.min(0.1, math.max(0, deadline - os.clock())))
	end
	return TemplateHub.active and TemplateHub.values[name]
end

---Find live module tables via require and optional getgc fallback.
local function collectModuleTables(loaderFn, moduleName, signatureCheck)
	local found = {}
	local seen = {}
	local ok, mod = pcall(loaderFn, moduleName)
	if ok and type(mod) == "table" and signatureCheck(mod) then
		seen[mod] = true
		table.insert(found, mod)
	end
	if type(getgc) == "function" then
		local gcOk, gcList = pcall(getgc, true)
		if gcOk and type(gcList) == "table" then
			for _, obj in ipairs(gcList) do
				if type(obj) == "table" and not seen[obj] and signatureCheck(obj) then
					seen[obj] = true
					table.insert(found, obj)
				end
			end
		end
	end
	return found
end

local function isThrowMeterTable(t)
	return type(rawget(t, "Run")) == "function"
		and type(rawget(t, "SetLocked")) == "function"
		and type(rawget(t, "SetTapsBlocked")) == "function"
		and type(rawget(t, "AddBlocker")) == "function"
end

local function isProjectileMathTable(t)
	return type(rawget(t, "FlightTime")) == "function"
		and type(rawget(t, "GravityFor")) == "function"
		and type(rawget(t, "CreateArc")) == "function"
end

local function isRevealSequenceTable(t)
	local runFn = rawget(t, "Run")
	if type(runFn) ~= "function" then return false end
	if type(debug) == "table" and type(debug.info) == "function" then
		local ok, src = pcall(debug.info, runFn, "s")
		if ok and type(src) == "string" and string.find(src, "RevealSequence", 1, true) then
			return true
		end
	end
	return false
end

local function isScreenFXTable(t)
	return type(rawget(t, "FadeOut")) == "function"
		and type(rawget(t, "FadeIn")) == "function"
		and type(rawget(t, "Cover")) == "function"
		and type(rawget(t, "Reset")) == "function"
end

---Character & world location helpers derived from PlotController, ThrowController, TrainingController, ThanksgivingController.
local function getCharacterRoot()
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum and hum.Health > 0) then
		return nil, "Character unavailable"
	end
	return hrp
end

local function moveRootTo(hrp, targetCF)
	if not (hrp and hrp.Parent) then return end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = targetCF
end

local function withCharacterAt(targetCF, fn)
	local hrp, err = getCharacterRoot()
	if not hrp then return false, err end
	local savedCF = hrp.CFrame
	moveRootTo(hrp, targetCF)
	runService.Heartbeat:Wait()
	local ok, r1, r2 = pcall(fn)
	if hrp and hrp.Parent then
		moveRootTo(hrp, savedCF)
	end
	if not ok then return false, tostring(r1) end
	return true, r1, r2
end

local function getPlotBasePos()
	local plotIdx = localPlayer:GetAttribute("PlotIndex")
	local plots = workspace:FindFirstChild("Plots")
	local plot = plots and plotIdx and plots:FindFirstChild(tostring(plotIdx))
	if not plot then return nil, "Plot not loaded yet" end
	return plot.Position
end

local function getTrainingSpotInfo()
	local props = workspace:FindFirstChild("LocalPlotProps")
	local area = props and props:FindFirstChild("TrainingArea")
	local spot = area and (area.PrimaryPart or area:FindFirstChild("TrainingSpot"))
	if spot and spot:IsA("BasePart") then
		return spot.Position, math.min(spot.Size.Y, spot.Size.Z) / 2
	end
	local plotPos, err = getPlotBasePos()
	if not plotPos then return nil, err end
	local ok, cfg = pcall(configModule, "GameConfig")
	local offset = ok and cfg.Plot and cfg.Plot.TrainingSpotOffset or Vector3.new(-16, 0.5, -30.5)
	return plotPos + offset, 5
end

local function getThrowLineCFrame(acrossLine)
	local starter = workspace:FindFirstChild("StarterArea")
	if not starter or not starter:IsA("BasePart") then
		return nil, "StarterArea not found"
	end
	local cross = starter:FindFirstChild("CrossLine")
	local lineZ = cross and cross:IsA("BasePart") and cross.Position.Z or (starter.Position.Z + starter.Size.Z / 2)
	local y = starter.Position.Y + starter.Size.Y / 2 + 3
	local z = acrossLine and (lineZ - 1.2) or (lineZ + 1.5)
	return CFrame.lookAt(Vector3.new(starter.Position.X, y, z), Vector3.new(starter.Position.X, y, z - 10))
end

local function getFenceSignCFrame()
	local plotPos, err = getPlotBasePos()
	if not plotPos then return nil, err end
	local plotIdx = localPlayer:GetAttribute("PlotIndex")
	local plot = workspace.Plots:FindFirstChild(tostring(plotIdx))
	local ok, fenceCfg = pcall(configModule, "FenceConfig")
	local offset = ok and fenceCfg.SignOffset or Vector3.new(-10, 0, -20)
	local pos = plotPos + offset
	local y = plot.Position.Y + plot.Size.Y / 2 + 3
	return CFrame.new(pos.X, y, pos.Z)
end

local function getTurkeyChefCFrame()
	local picnic = workspace:FindFirstChild("ThanksgivingPicnic")
	local chef = picnic and picnic:FindFirstChild("TurkeyChef")
	if not chef then return nil, "Turkey Chef not in world" end
	local pos = chef.PrimaryPart and chef.PrimaryPart.Position or chef:GetPivot().Position
	return CFrame.lookAt(pos + Vector3.new(0, 3, 4), pos + Vector3.new(0, 3, 0))
end

local function ensureInvokeHook()
	if invokeHookInstalled or type(hookfunction) ~= "function" then return end
	local ok, rf = pcall(Instance.new, "RemoteFunction")
	if not ok or not rf then return end
	local fn = rf.InvokeServer
	pcall(function() rf:Destroy() end)
	if type(fn) ~= "function" then return end
	local hookOk, orig = pcall(hookfunction, fn, function(self, ...)
		if TemplateHub.active and TemplateHub.values["Auto Perfect"]
			and typeof(self) == "Instance" and self:IsA("RemoteFunction") and self.Name == "Throw_Resolve" then
			return originalInvokeServer(self, 1)
		end
		return originalInvokeServer(self, ...)
	end)
	if hookOk and type(orig) == "function" then
		originalInvokeServer = orig
		invokeHookInstalled = true
	end
end

-- Patch ThrowMeter.Run (locking meter + returning 1.0 + PERFECT rating) and hook InvokeServer when available.
local function restorePerfect()
	for _, entry in ipairs(patchedMeterEntries) do
		if entry.mod and entry.mod.Run == entry.patched then
			entry.mod.Run = entry.original
		end
	end
	table.clear(patchedMeterEntries)
end
TemplateHub.restorePerfect = restorePerfect

local function setPerfect(enabled)
	if not enabled then restorePerfect(); return true end
	if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	ensureInvokeHook()
	local meters = collectModuleTables(clientModule, "ThrowMeter", isThrowMeterTable)
	if #meters == 0 and not invokeHookInstalled then
		return false, "ThrowMeter module unavailable"
	end
	restorePerfect()
	local okCfg, gameCfg = pcall(configModule, "GameConfig")
	for _, meter in ipairs(meters) do
		local orig = meter.Run
		local patched
		patched = function(self, ...)
			if TemplateHub.active and TemplateHub.values["Auto Perfect"] then
				if type(self) == "table" and type(self.SetLocked) == "function" then
					pcall(self.SetLocked, self, true)
				end
			end
			local results = table.pack(orig(self, ...))
			if TemplateHub.active and TemplateHub.values["Auto Perfect"] and type(results[1]) == "number" then
				results[1] = 1
				if okCfg and gameCfg and gameCfg.Throw then
					if type(gameCfg.Throw.MeterRatings) == "table" and gameCfg.Throw.MeterRatings[1] then
						results[2] = gameCfg.Throw.MeterRatings[1]
					end
					if type(gameCfg.Throw.MeterBonusStuds) == "number" then
						results[3] = gameCfg.Throw.MeterBonusStuds
					end
				end
				if type(self) == "table" and self.Prompt and results[2] and results[2].Text then
					pcall(function() self.Prompt.Text = results[2].Text end)
				end
			end
			return table.unpack(results, 1, results.n)
		end
		meter.Run = patched
		table.insert(patchedMeterEntries, { mod = meter, original = orig, patched = patched })
	end
	return true
end

---Run the throw sequence with proper StarterArea positioning, cooldown waiting, retry handling, and training support.
local function setFarm(enabled)
	if not enabled then return true end
	if farmWorker then return false, "Previous farm call is still finishing" end
	if trainWorker or TemplateHub.values["Auto Train"] then return false, "Stop Auto Train before farming" end
	for _, name in ipairs({ "Throw_Start", "Throw_MeterStarted", "Throw_Resolve", "Throw_Revealed", "Throw_Complete" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	farmWorker = true
	task.spawn(function()
		local function step(name, ...)
			if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then return false end
			local ok, result = callRemote(name, false, ...)
			if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then return false end
			if not ok or (remoteTypes[name] == "RemoteFunction" and (type(result) ~= "table" or result.Ok ~= true)) then
				TemplateHub.report(ok and (name .. " returned an unexpected response") or tostring(result), true)
				TemplateHub.setters["Farm Animals"](false)
				return false
			end
			return true, result
		end
		local throwCount, training, throwPending = 0, false, false
		local ok, errorMessage = xpcall(function()
			local clientStateOk, clientState = pcall(clientModule, "ClientState")
			while TemplateHub.active and TemplateHub.values["Farm Animals"] do
				-- Wait out any active throw cooldown before starting.
				local readyAt = localPlayer:GetAttribute("ThrowReadyAt")
				if type(readyAt) == "number" then
					local waitLeft = readyAt - workspace:GetServerTimeNow()
					if waitLeft > 0 and not waitEnabled("Farm Animals", waitLeft + 0.1) then break end
				end
				if localPlayer:GetAttribute("Training") == true then
					callRemote("Training_Stop", true)
					if not waitEnabled("Farm Animals", 0.2) then break end
				end

				-- Prepare Auto Thanksgiving Index / Auto Index target throw power.
				local sandwichToUse = nil
				if TemplateHub.values["Auto Thanksgiving Index"] then
					local tgOk, tgChoice = pcall(prepareThanksgivingIndex)
					if tgOk and type(tgChoice) == "string" then
						sandwichToUse = tgChoice
					else
						TemplateHub.report("Thanksgiving Index: " .. tostring(tgChoice), true)
						TemplateHub.setters["Auto Thanksgiving Index"](false)
						if TemplateHub.values["Auto Index"] then
							prepareIndex()
						end
					end
				elseif TemplateHub.values["Auto Index"] then
					prepareIndex()
				end
				if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then break end

				-- Start throw at StarterArea CrossLine (just in front first; cross line with ClientState.Busy guard if TooFar).
				local lineCF, lineErr = getThrowLineCFrame(false)
				if not lineCF then error(lineErr) end
				local startOk, startResult = false, nil
				for attempt = 1, 2 do
					local moveOk, sOk, sRes = withCharacterAt(lineCF, function()
						return callRemote("Throw_Start", false)
					end)
					if not moveOk then error(sRes and tostring(sRes) or tostring(sOk)) end
					startOk, startResult = sOk, sRes
					if not startOk and tostring(startResult):find("TooFar", 1, true) then
						local crossCF = getThrowLineCFrame(true)
						if crossCF then
							local prevBusy = clientStateOk and clientState.Busy or nil
							if clientStateOk then clientState.Busy = "HubFarm" end
							local m2, sOk2, sRes2 = withCharacterAt(crossCF, function()
								return callRemote("Throw_Start", false)
							end)
							if clientStateOk and clientState.Busy == "HubFarm" then clientState.Busy = prevBusy end
							if m2 then startOk, startResult = sOk2, sRes2 end
						end
					end
					if startOk and type(startResult) == "table" and startResult.Ok == true then
						break
					end
					local reasonStr = tostring(startResult)
					if reasonStr:find("Cooldown", 1, true) or reasonStr:find("Wait", 1, true) then
						local rAt = localPlayer:GetAttribute("ThrowReadyAt")
						local waitFor = (type(rAt) == "number" and math.max(0.25, rAt - workspace:GetServerTimeNow() + 0.1)) or 0.75
						if not waitEnabled("Farm Animals", waitFor) then break end
					elseif attempt == 1 and (reasonStr:find("Already", 1, true) or reasonStr:find("InProgress", 1, true)) then
						callRemote("Throw_Cancel", true, "Reset")
						if not waitEnabled("Farm Animals", 0.25) then break end
					else
						break
					end
				end
				if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then break end
				if startOk and type(startResult) == "table" and startResult.Ok == true then throwPending = true end
				if not startOk or not throwPending then
					TemplateHub.report(startOk and "Throw_Start returned an unexpected response" or tostring(startResult), true)
					TemplateHub.setters["Farm Animals"](false)
					break
				end

				if not step("Throw_MeterStarted") then break end
				if sandwichToUse then
					callRemote("Throw_UseSandwich", false, sandwichToUse)
				end
				if not waitEnabled("Farm Animals", TemplateHub.values["Meter Delay"]) then break end
				-- Power meter always resolves to 1 (+20 bonus studs).
				local resolvedOk, resolvedResult = step("Throw_Resolve", 1)
				if not resolvedOk then break end
				local revealWait = TemplateHub.values["Reveal Delay"]
				if not TemplateHub.values["Instant Throw"] and type(resolvedResult) == "table" and type(resolvedResult.FlightTime) == "number" then
					revealWait = math.max(revealWait, resolvedResult.FlightTime + 0.25)
				end
				if not waitEnabled("Farm Animals", revealWait) then break end
				if not step("Throw_Revealed") then break end
				if not waitEnabled("Farm Animals", TemplateHub.values["Complete Delay"]) then break end
				if not step("Throw_Complete") then break end
				throwPending = false
				throwCount += 1

				if TemplateHub.values["Train Between Farms"] and throwCount >= TemplateHub.values["Train After Throws"] then
					local data = playerData()
					if (tonumber(data.Stand) or 0) >= 1 then
						local spotPos, radius = getTrainingSpotInfo()
						if not spotPos then error(radius) end
						local hrp, hrpErr = getCharacterRoot()
						if not hrp then error(hrpErr) end
						local savedCF = hrp.CFrame
						local prevBusy = clientStateOk and clientState.Busy or nil
						if clientStateOk then clientState.Busy = "HubTrain" end
						moveRootTo(hrp, CFrame.new(spotPos + Vector3.new(0, 3, 0)))
						runService.Heartbeat:Wait()
						local trainOk, response = callRemote("Training_Start", false)
						if not trainOk or type(response) ~= "table" or response.Ok ~= true then
							moveRootTo(hrp, savedCF)
							if clientStateOk and clientState.Busy == "HubTrain" then clientState.Busy = prevBusy end
							error(trainOk and "Training_Start returned an unexpected response" or tostring(response))
						end
						moveRootTo(hrp, CFrame.new(spotPos + Vector3.new(math.max((radius or 5) * 0.78, 3.8), 3, 0)))
						if clientStateOk and clientState.Busy == "HubTrain" then clientState.Busy = prevBusy end
						training = true
						waitEnabled("Farm Animals", TemplateHub.values["Train for(s)"])
						local stopOk, stopResult = callRemote("Training_Stop", true)
						training = false
						moveRootTo(hrp, savedCF)
						if not stopOk then error(tostring(stopResult)) end
					end
					throwCount = 0
				end
				if not waitEnabled("Farm Animals", TemplateHub.values["Farm Delay"]) then break end
			end
		end, function(errorMessage) return tostring(errorMessage) end)
		if training then callRemote("Training_Stop", true) end
		if throwPending then callRemote("Throw_Cancel", true) end
		farmWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Farm Animals"](false)
			TemplateHub.report("Farm stopped: " .. errorMessage, true)
		end
	end)
	return true
end

---Keep one training session active until the toggle is turned off (moves to TrainingSpot cleanly without camera lock).
local function setAutoTrain(enabled)
	if not enabled then return true end
	if trainWorker then return false, "Previous training call is still finishing" end
	if farmWorker or TemplateHub.values["Farm Animals"] then return false, "Stop farming before training" end
	for _, name in ipairs({ "Training_Start", "Training_Stop" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	local okData, data = pcall(playerData)
	if okData and (tonumber(data.Stand) or 0) < 1 then
		return false, "Buy a pull-up bar first"
	end
	trainWorker = true
	task.spawn(function()
		local started = false
		local savedCF = nil
		local clientStateOk, clientState = pcall(clientModule, "ClientState")
		local function startAtSpot()
			local spotPos, radius = getTrainingSpotInfo()
			if not spotPos then return false, radius end
			local hrp, hrpErr = getCharacterRoot()
			if not hrp then return false, hrpErr end
			if not savedCF then savedCF = hrp.CFrame end
			-- First try edge inside server range but outside TrainingController's 0.64*radius auto-trigger.
			local edgeOffset = Vector3.new(math.max((radius or 5) * 0.78, 3.8), 3, 0)
			moveRootTo(hrp, CFrame.new(spotPos + edgeOffset))
			runService.Heartbeat:Wait()
			local accepted, result = callRemote("Training_Start", false)
			if not accepted and tostring(result):find("TooFar", 1, true) then
				local prevBusy = clientStateOk and clientState.Busy or nil
				if clientStateOk then clientState.Busy = "HubTrain" end
				moveRootTo(hrp, CFrame.new(spotPos + Vector3.new(0, 3, 0)))
				runService.Heartbeat:Wait()
				accepted, result = callRemote("Training_Start", false)
				moveRootTo(hrp, CFrame.new(spotPos + edgeOffset))
				if clientStateOk and clientState.Busy == "HubTrain" then clientState.Busy = prevBusy end
			end
			return accepted, result
		end
		local ok, errorMessage = xpcall(function()
			local accepted, result = startAtSpot()
			if not accepted then
				if TemplateHub.active then
					TemplateHub.setters["Auto Train"](false)
					TemplateHub.report(tostring(result), true)
				end
				return
			end
			started = true
			while TemplateHub.active and TemplateHub.values["Auto Train"] do
				task.wait(0.25)
