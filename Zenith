---Find a captured remote without loading game modules.
local function findRemote(name)
	if game.PlaceId ~= GAME_PLACE_ID then return nil, "Join Throw Food for Animals first." end
	local folder = replicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild(name)
	if not remote or remote.ClassName ~= remoteTypes[name] then
		return nil, name .. " missing or class changed"
	end
	return remote
end

---Make a captured call; unknown responses are not treated as verified success.
local function callRemote(name, allowInactive, ...)
	if not TemplateHub.active and not allowInactive then return false, "Menu closed" end
	local remote, reason = findRemote(name)
	if not remote then return false, reason end
	if remoteBusy[name] then return false, name .. " is already in flight" end
	remoteBusy[name] = true
	local args = table.pack(...)
	local ok, result = pcall(function()
		if remote.ClassName == "RemoteEvent" then
			remote:FireServer(table.unpack(args, 1, args.n))
			return nil
		end
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	remoteBusy[name] = nil
	if not ok then return false, name .. ": " .. tostring(result) end
	if type(result) == "table" and result.Ok == false then
		return false, name .. " rejected: " .. tostring(result.Reason or result.Message or result.Error or "Ok=false")
	end
	return true, result
end

---Wait in short intervals so an automation toggle can stop its worker.
local function waitEnabled(name, seconds)
	local deadline = os.clock() + seconds
	while TemplateHub.active and TemplateHub.values[name] and os.clock() < deadline do
		task.wait(math.min(0.2, math.max(0, deadline - os.clock())))
	end
	return TemplateHub.active and TemplateHub.values[name]
end

-- Remotes.Invoke in the supplied client uses dot calls, not namecalls. Patch the
-- live ThrowMeter module's Run method instead; restore only our own replacement.
local function restorePerfect()
	if perfectModule and perfectModule.Run == patchedMeterRun then perfectModule.Run = originalMeterRun end
	perfectModule, originalMeterRun, patchedMeterRun = nil, nil, nil
end
TemplateHub.restorePerfect = restorePerfect
local function setPerfect(enabled)
	if not enabled then restorePerfect(); return true end
	if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	local ok, meter = pcall(clientModule, "ThrowMeter")
	if not ok then return false, tostring(meter) end
	if type(meter.Run) ~= "function" then return false, "ThrowMeter.Run unavailable" end
	perfectModule, originalMeterRun = meter, meter.Run
	local original = originalMeterRun
	patchedMeterRun = function(...)
		local results = table.pack(original(...))
		if TemplateHub.active and TemplateHub.values["Auto Perfect"] and type(results[1]) == "number" then results[1] = 1 end
		return table.unpack(results, 1, results.n)
	end
	meter.Run = patchedMeterRun
	return true
end

---Run the observed throw sequence using conservative, configurable delays.
local function setFarm(enabled)
	if not enabled then return true end
	if farmWorker then return false, "Previous farm call is still finishing" end
	if trainWorker or TemplateHub.values["Auto Train"] then return false, "Stop Auto Train before farming" end
	for _, name in ipairs({ "Throw_Start", "Throw_MeterStarted", "Throw_Resolve", "Throw_Revealed", "Throw_Complete" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	farmWorker = true
	task.spawn(function()
		local function step(name, ...)
			if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then return false end
			local ok, result = callRemote(name, false, ...)
			if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then return false end
			if not ok or (remoteTypes[name] == "RemoteFunction" and (type(result) ~= "table" or result.Ok ~= true)) then
				TemplateHub.report(ok and (name .. " returned an unexpected response") or tostring(result), true)
				TemplateHub.setters["Farm Animals"](false)
				return false
			end
			return true
		end
		local throwCount, training, throwPending = 0, false, false
		local ok, errorMessage = xpcall(function()
			while TemplateHub.active and TemplateHub.values["Farm Animals"] do
				if TemplateHub.values["Auto Index"] then prepareIndex() end
				if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then break end
				-- Start may finish after a stop request; remember an accepted start so it can be cancelled.
				local startOk, startResult = callRemote("Throw_Start", false)
				if startOk and type(startResult) == "table" and startResult.Ok == true then throwPending = true end
				if not TemplateHub.active or not TemplateHub.values["Farm Animals"] then break end
				if not startOk or not throwPending then
					TemplateHub.report(startOk and "Throw_Start returned an unexpected response" or tostring(startResult), true)
					TemplateHub.setters["Farm Animals"](false)
					break
				end
				if not step("Throw_MeterStarted") then break end
				if not waitEnabled("Farm Animals", TemplateHub.values["Meter Delay"]) then break end
				if not step("Throw_Resolve", TemplateHub.values["Auto Perfect"] and 1 or TemplateHub.values["Throw Power"]) then break end
				if not waitEnabled("Farm Animals", TemplateHub.values["Reveal Delay"]) then break end
				if not step("Throw_Revealed") then break end
				if not waitEnabled("Farm Animals", TemplateHub.values["Complete Delay"]) then break end
				if not step("Throw_Complete") then break end
				throwPending = false
				throwCount += 1
				if TemplateHub.values["Train Between Farms"] and throwCount >= TemplateHub.values["Train After Throws"] then
					local trainOk, response = callRemote("Training_Start", false)
					if not trainOk or type(response) ~= "table" or response.Ok ~= true then
						error(trainOk and "Training_Start returned an unexpected response" or tostring(response))
					end
					training = true
					waitEnabled("Farm Animals", TemplateHub.values["Train for(s)"])
					local stopOk, stopResult = callRemote("Training_Stop", true)
					training = false
					if not stopOk then error(tostring(stopResult)) end
					throwCount = 0
				end
				if not waitEnabled("Farm Animals", TemplateHub.values["Farm Delay"]) then break end
			end
		end, function(errorMessage) return tostring(errorMessage) end)
		if training then callRemote("Training_Stop", true) end
		if throwPending then callRemote("Throw_Cancel", true) end
		farmWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Farm Animals"](false)
			TemplateHub.report("Farm stopped: " .. errorMessage, true)
		end
	end)
	TemplateHub.report("Farm Animals is experimental; verify each step in-game.")
	return true
end

---Keep one training session active until the toggle is turned off.
local function setAutoTrain(enabled)
	if not enabled then return true end
	if trainWorker then return false, "Previous training call is still finishing" end
	if farmWorker or TemplateHub.values["Farm Animals"] then return false, "Stop farming before training" end
	for _, name in ipairs({ "Training_Start", "Training_Stop" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	trainWorker = true
	task.spawn(function()
		local started = false
		local ok, errorMessage = xpcall(function()
			local accepted, result = callRemote("Training_Start", false)
			if not accepted then
				if TemplateHub.active then
					TemplateHub.setters["Auto Train"](false)
					TemplateHub.report(tostring(result), true)
				end
				return
			end
			started = true
			while TemplateHub.active and TemplateHub.values["Auto Train"] do task.wait(0.2) end
		end, function(message) return tostring(message) end)
		if started then
			local stopped, result = callRemote("Training_Stop", true)
			if not stopped and TemplateHub.active then TemplateHub.report(tostring(result), true) end
		end
		trainWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Auto Train"](false)
			TemplateHub.report("Training stopped: " .. errorMessage, true)
		end
	end)
	return true
end

