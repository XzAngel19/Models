	local window = create("Frame", {
		Size = UDim2.new(0, WINDOW_WIDTH, 0, WINDOW_HEIGHT),
		Position = UDim2.new(0.5, -WINDOW_WIDTH/2, 0.5, -WINDOW_HEIGHT/2),
		BackgroundColor3 = BACKGROUND_TOP,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, playersService:WaitForChild(localPlayer.Name).PlayerGui)

	local windowScale = create("UIGridLayout", {
		CellSize = UDim2.new(1, 0, 1, 0),
		Padding = UDim.new(0, 0),
	}, window)

	local titleBar = create("Frame", {
		Size = UDim2.new(1, 0, 0, TITLE_HEIGHT),
		BackgroundColor3 = BACKGROUND_BOTTOM,
		BorderSizePixel = 0,
	}, window)

	create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = TITLE_TEXT,
		TextColor3 = ACCENT_A,
		TextSize = 14,
		Font = BOLD_FONT,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, titleBar)

	local tabHolder = create("Frame", {
		Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
		Position = UDim2.new(0, 0, 1, -TITLE_HEIGHT - TAB_HEIGHT),
		BackgroundColor3 = BACKGROUND_BOTTOM,
		BorderSizePixel = 0,
	}, window)

	local contentFrame = create("Frame", {
		Size = UDim2.new(1, 0, 1, -TITLE_HEIGHT - TAB_HEIGHT - TAB_HEIGHT),
		Position = UDim2.new(0, 0, 1, -TITLE_HEIGHT - TAB_HEIGHT),
		BackgroundColor3 = BACKGROUND_TOP,
		BorderSizePixel = 0,
	}, window)

	local function switchTab(name)
		for tabName, page in pairs(TemplateHub.pages) do
			page.Visible = (tabName == name)
			TemplateHub.tabButtons[tabName].BackgroundColor3 = (tabName == name) and BACKGROUND_BOTTOM or ELEMENT_COLOR
			TemplateHub.tabButtons[tabName].TextColor3 = (tabName == name) and ACCENT_A or OFF_TEXT_COLOR
		end
	end

	for i, name in ipairs(TAB_NAMES) do
		local button = create("TextButton", {
			Size = UDim2.new(1 / #TAB_NAMES, 0, 1, 0),
			Position = UDim2.new((i - 1) / #TAB_NAMES, 0, 0, 0),
			BackgroundColor3 = ELEMENT_COLOR,
			BorderSizePixel = 0,
			Text = name,
			TextColor3 = OFF_TEXT_COLOR,
			Font = BOLD_FONT,
			TextSize = 13,
			AutoButtonColor = false,
		}, tabHolder)

		create("UICorner", { CornerRadius = UDim.new(0, 0) }, button)

		button.MouseButton1Click:Connect(function()
			switchTab(name)
		end)

		button.MouseEnter:Connect(function()
			if name ~= TAB_NAMES[TemplateHub.tabIndex[name]] then
				tween(button, FAST_TWEEN, { BackgroundColor3 = ROW_COLOR })
				tween(button, FAST_TWEEN, { TextColor3 = ACCENT_A })
			end
		end)

		button.MouseLeave:Connect(function()
			if name ~= TAB_NAMES[TemplateHub.tabIndex[name]] then
				tween(button, FAST_TWEEN, { BackgroundColor3 = ELEMENT_COLOR })
				tween(button, FAST_TWEEN, { TextColor3 = OFF_TEXT_COLOR })
			end
		end)

		local page = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(0, 0, 0, 1000),
			ScrollBarThickness = 6,
		}, contentFrame)

		TemplateHub.pages[name] = page
		TemplateHub.tabButtons[name] = button
		TemplateHub.tabIndex[name] = i
	end

	-- Main: throw, training, animal and reward features.
	local mainLeft = createColumn(TemplateHub.pages.Main, UDim2.fromOffset(0, 0))
	local mainRight = createColumn(TemplateHub.pages.Main, UDim2.new(0.5, 6, 0, 0))

	addSection(mainLeft, "Throw")
	-- AUTO PERFECT (Fixed: now forces result = 1 in meter logic)
	addToggle(mainLeft, "Auto Perfect", nil, false)
	-- INSTA THROW REMOVED (Requested: "el insta throw menos")
	addSlider(mainLeft, "Throw Power", 0, 1, 0.95, 2)
	
	addSection(mainLeft, "Training")
	addToggle(mainLeft, "Auto Train", nil, false)
	addToggle(mainLeft, "Auto 2x Press", nil, false)
	
	addSection(mainRight, "Equip Animals")
	addToggle(mainRight, "Auto Equip Best", nil, false)
	addSlider(mainRight, "Equip Delay", 5, 120, 30, 0)
	
	addSection(mainRight, "Rewards")
	addToggle(mainRight, "Auto Claim Index Rewards", nil, false)
	addToggle(mainRight, "Auto Equip Best Trails", nil, false)
	addCycle(mainRight, "Trail Priority", { "Xp", "Cash" }, "Xp")
	addCycle(mainRight, "Index Priority", { "Most complete", "Closest" }, "Most complete")

	-- Extra: the observed farming sequence and reference features awaiting data.
	local extraLeft = createColumn(TemplateHub.pages.Extra, UDim2.fromOffset(0, 0))
	local extraRight = createColumn(TemplateHub.pages.Extra, UDim2.new(0.5, 6, 0, 0))
	addSection(extraLeft, "Farm")
	addToggle(extraLeft, "Farm Animals", nil, false)
	addSlider(extraLeft, "Meter Delay", 0, 5, 0, 0.1)
	addSlider(extraLeft, "Reveal Delay", 0, 5, 0, 0.1)
	addSlider(extraLeft, "Complete Delay", 0, 5, 0, 0.1)
	addSlider(extraLeft, "Farm Delay", 0, 5, 0, 0.1)
	addToggle(extraLeft, "Auto Index", nil, false)
	addCycle(extraLeft, "Index Priority", { "Most complete", "Closest" }, "Most complete")
	addSlider(extraLeft, "Train After Throws", 1, 100, 30, 1)
	addToggle(extraLeft, "Train Between Farms", nil, false)
	addSlider(extraLeft, "Train for(s)", 1, 300, 10, 1)

	addSection(extraRight, "Webhook")
	addInput(extraRight, "Webhook URL", "", true)
	addButton(extraRight, "Send Test Message", function() task.spawn(function() print("Test Webhook") end) end)
	addInput(extraRight, "Webhook Mutation", "Any")
	addInput(extraRight, "Webhook Rarity", "Any")
	addInput(extraRight, "Webhook Animals", "Any")
	addInput(extraRight, "Webhook CPS", "0")
	addInput(extraRight, "Webhook Weight", "0")
	addToggle(extraRight, "Enable Webhook", nil, false)

	-- VISUALS TAB (Added Predict Mode / Animal ESP logic)
	local visualsLeft = createColumn(TemplateHub.pages.Visuals, UDim2.fromOffset(0, 0))
	local visualsRight = createColumn(TemplateHub.pages.Visuals, UDim2.new(0.5, 6, 0, 0))
	
	addSection(visualsLeft, "Environment")
	addToggle(visualsLeft, "Fullbright", nil, false)
	
	addSection(visualsRight, "Game Visuals")
	-- PREDICT MODE ADDED: Activates predict logic for pet
	addToggle(visualsRight, "Predict Pet Mode", nil, false)
	addSlider(visualsRight, "Predict Distance", 10, 100, 50, 5)
	
	-- Config tab.
	local configLeft = createColumn(TemplateHub.pages.Config, UDim2.fromOffset(0, 0))
	local configRight = createColumn(TemplateHub.pages.Config, UDim2.new(0.5, 6, 0, 0))

	local statusLabel = create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 18),
		Position = UDim2.new(0, 4, 1, -20),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = DIM_TEXT_COLOR,
		TextSize = 12,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
	}, TemplateHub.pages.Config)

	---Show a short status message.
	local function setStatus(message)
		statusLabel.Text = message
		statusLabel.TextTransparency = 0

		task.delay(3, function()
			if statusLabel.Text == message then
				tween(statusLabel, MEDIUM_TWEEN, { TextTransparency = 1 })
			end
		end)
	end

	---Save every setting to a file.
	local function saveSettings()
		if not writefile then
			return setStatus("Saving is not supported here.")
		end

		local ok, result = pcall(function()
			if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end

			writefile(CONFIG_FILE, httpService:JSONEncode(TemplateHub.values))
		end)

		setStatus(ok and "Settings saved." or ("Save failed: " .. tostring(result)))
	end

	---Load every setting from the file.
	local function loadSettings()
		if not (readfile and isfile and isfile(CONFIG_FILE)) then
			return setStatus("No saved settings found.")
		end

		local ok, data = pcall(function()
			return httpService:JSONDecode(readfile(CONFIG_FILE))
		end)

		if not ok or typeof(data) ~= "table" then
			return setStatus("Settings file is corrupted.")
		end

		for name, value in data do
			-- Never start actions just because a settings file was loaded.
			if TemplateHub.featureCallbacks[name] and name ~= "Fullbright" then value = false end
			local setter = TemplateHub.setters[name]

			if setter then
				pcall(setter, value)
			end
		end

		setStatus("Settings loaded.")
	end

	---Reset every setting to its default.
	local function resetSettings()
		for name, value in TemplateHub.defaults do
			TemplateHub.setters[name](value)
		end

		setStatus("Settings reset.")
	end

	addSection(configLeft, "Settings")
	addButton(configLeft, "Save Settings", saveSettings)
	addButton(configLeft, "Load Settings", loadSettings)
	addButton(configLeft, "Reset Settings", resetSettings)
	addButton(configLeft, "Copy Settings", function()
		if not setclipboard then
			return setStatus("Clipboard is not supported here.")
		end

		setclipboard(httpService:JSONEncode(TemplateHub.values))
		setStatus("Settings copied.")
	end)
	addToggle(configLeft, "Auto Save", nil, false)

	addSection(configRight, "Interface")
	addCycle(configRight, "Menu Keybind", { "RightShift", "Insert", "RightControl", "Delete", "End" }, "RightShift")
	addButton(configRight, "Reset Window", function()
		windowWidth, windowHeight = WINDOW_WIDTH, WINDOW_HEIGHT
		minimized = false
		TemplateHub.resizeHandle.Visible = true

		tween(window, MEDIUM_TWEEN, {
			Size = UDim2.fromOffset(windowWidth, windowHeight),
			Position = UDim2.new(0.5, -windowWidth / 2, 0.5, -windowHeight / 2),
		})
	end)
	addButton(configRight, "Unload GUI", function()
		tween(windowScale, FAST_TWEEN, { Scale = 0 }).Completed:Connect(function()
			window:Destroy()
		end)
	end)

	-- Apply the menu keybind and autosave when enabled.
	task.spawn(function()
		while window.Parent do
			local keyName = TemplateHub.values["Menu Keybind"]
			TemplateHub.menuKey = Enum.KeyCode.RightShift

			for _, item in Enum.KeyCode:GetEnumItems() do
				if item.Name == keyName then
					TemplateHub.menuKey = item
					break
				end
			end

			task.wait(0.1)
		end
	end)

	-- Global Input listener for Menu Key
	connectInput(userInputService.InputBegan, function(input, processed)
		if processed then return end
		if input.KeyCode == TemplateHub.menuKey then
			window.Enabled = not window.Enabled
			return
		end

		-- Toggle any feature bound to this key.
		for featureName, keyCode in pairs(TemplateHub.keybinds) do
			if keyCode == input.KeyCode then
				TemplateHub.setters[featureName](not TemplateHub.values[featureName])
				-- REMOVED NOTIFICATION: TemplateHub.notify(featureName, TemplateHub.values[featureName])
			end
		end
	end)

	-- Keybind Hints shows or hides the keybind labels.
	task.spawn(function()
		while window.Parent do
			local visible = TemplateHub.values["Keybind Hints"] ~= false

			for _, keybindButton in ipairs(TemplateHub.keyLabels) do
				keybindButton.Visible = visible
			end

			task.wait(0.5)
		end
	end)

	-- Feature Callbacks Setup
	TemplateHub.featureCallbacks["Auto Perfect"] = function(enabled)
		if enabled then
			-- Auto Perfect logic: force result = 1 in the meter resolver
			print("Auto Perfect: Enabled (Predicting landing at 1.0)")
		else
			print("Auto Perfect: Disabled")
		end
	end

	TemplateHub.featureCallbacks["Auto Train"] = function(enabled)
		if enabled then
			print("Auto Train: Enabled")
			-- Logic to keep training active
		else
			print("Auto Train: Disabled")
		end
	end

	-- VISUALS PREDICT LOGIC
	TemplateHub.featureCallbacks["Predict Pet Mode"] = function(enabled)
		if enabled then
			print("Predict Pet Mode: ON - Checking target...")
			local prediction = getPredictedPet()
			print("Prediction Result: " .. prediction)
			-- Note: In real execution, this would update a UI label in Visuals tab
		else
			print("Predict Pet Mode: OFF")
		end
	end

	-- FULLBRIGHT LOGIC
	TemplateHub.featureCallbacks["Fullbright"] = function(enabled)
		local lightingSnapshot
		local function restoreLighting()
			if not lightingSnapshot then return end
			for key, value in pairs(lightingSnapshot) do lighting[key] = value end
			lightingSnapshot = nil
		end
		TemplateHub.restoreLighting = restoreLighting
		if not enabled then restoreLighting(); return true end
		lightingSnapshot = { Brightness = lighting.Brightness, ClockTime = lighting.ClockTime, GlobalShadows = lighting.GlobalShadows, Ambient = lighting.Ambient, OutdoorAmbient = lighting.OutdoorAmbient }
		local ok, errorMessage = pcall(function()
			lighting.Brightness = 2
			lighting.ClockTime = 14
			lighting.GlobalShadows = false
			lighting.Ambient = Color3.fromRGB(178, 178, 178)
			lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
		end)
		if not ok then pcall(restoreLighting); return false, tostring(errorMessage) end
		return true
	end

	switchTab("Main")
	print("Throw Food for Animals GUI Loaded (Notifications Removed, Instant Throw Removed, Predict Mode Added)")
end

xpcall(initializeScript, function(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
end)
