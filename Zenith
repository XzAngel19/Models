		Position = UDim2.fromScale(0.5, 0.5),
		Size = default and UDim2.fromOffset(10, 10) or UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, box)

	create("UICorner", { CornerRadius = UDim.new(0, 3) }, check)
	addGradient(check, 45)

	local label = create("TextLabel", {
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT_COLOR,
		TextSize = 13,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, holder)

	local keybindLabel = nil
	if keybind then
		keybindLabel = create("TextLabel", {
			Size = UDim2.new(0, 24, 1, 0),
			Position = UDim2.new(1, -32, 0, 0),
			BackgroundTransparency = 1,
			Text = tostring(keybind),
			TextColor3 = OFF_TEXT_COLOR,
			TextSize = 10,
			Font = BOLD_FONT,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
		}, holder)

		table.insert(TemplateHub.keyLabels, keybindLabel)
	end

	local enabled = default or false
	local function updateToggle()
		box.BackgroundColor3 = enabled and ACCENT_A or ELEMENT_COLOR
		boxStroke.Color = enabled and ACCENT_A or DIM_TEXT_COLOR
		boxStroke.Transparency = enabled and 0 or 0.5
		check.Size = enabled and UDim2.fromOffset(10, 10) or UDim2.fromOffset(0, 0)
		TemplateHub.values[text] = enabled
		if TemplateHub.featureCallbacks[text] then
			TemplateHub.featureCallbacks[text](enabled)
		end
		-- REMOVED NOTIFICATION: TemplateHub.notify(text, enabled, false)
	end

	holder.MouseButton1Click:Connect(function()
		enabled = not enabled
		updateToggle()
		if keybindLabel then
			keybindLabel.TextColor3 = enabled and ACCENT_A or OFF_TEXT_COLOR
		end
	end)

	updateToggle()
	TemplateHub.setters[text] = function(val)
		enabled = val
		updateToggle()
		if keybindLabel then
			keybindLabel.TextColor3 = enabled and ACCENT_A or OFF_TEXT_COLOR
		end
	end
	TemplateHub.defaults[text] = default
	if keybind then
		TemplateHub.keybinds[text] = keybind
	end
	return holder, stroke
end

---Add a slider row.
local function addSlider(parent, text, minVal, maxVal, default, step, callback)
	local holder, stroke = createCard("Frame", parent, text, 28)
	holder.Text = ""
	holder.AutoButtonColor = false

	local label = create("TextLabel", {
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT_COLOR,
		TextSize = 13,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, holder)

	local valueBox = create("Frame", {
		Size = UDim2.fromOffset(80, 20),
		Position = UDim2.new(1, -90, 0.5, -10),
		BackgroundColor3 = ELEMENT_COLOR,
		BorderSizePixel = 0,
	}, holder)

	create("UICorner", { CornerRadius = UDim.new(0, 4) }, valueBox)
	addStroke(valueBox, ACCENT_A, 0.5)

	local valueLabel = create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(default),
		TextColor3 = TEXT_COLOR,
		TextSize = 12,
		Font = BOLD_FONT,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, valueBox)

	local value = default
	local function updateSlider()
		valueLabel.Text = string.format("%.2f", value)
		TemplateHub.values[text] = value
		if TemplateHub.featureCallbacks[text] then
			TemplateHub.featureCallbacks[text](value)
		end
		if callback then callback(value) end
	end

	-- Click to increment
	valueBox.MouseButton1Click:Connect(function()
		value = math.min(maxVal, value + (step or 0.05))
		updateSlider()
	end)

	-- Right click to decrement
	userInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			local pos = input.Position
			local framePos = valueBox.AbsolutePosition
			local frameSize = valueBox.AbsoluteSize
			if pos.X >= framePos.X and pos.X <= framePos.X + frameSize.X and
			   pos.Y >= framePos.Y and pos.Y <= framePos.Y + frameSize.Y then
				value = math.max(minVal, value - (step or 0.05))
				updateSlider()
			end
		end
	end)

	updateSlider()
	TemplateHub.setters[text] = function(val)
		value = val
		updateSlider()
	end
	TemplateHub.defaults[text] = default
	return holder, stroke
end

---Add a cycle row.
local function addCycle(parent, text, options, default, callback)
	local holder, stroke = createCard("Frame", parent, text, 28)
	holder.Text = ""
	holder.AutoButtonColor = false

	local label = create("TextLabel", {
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = TEXT_COLOR,
		TextSize = 13,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, holder)

	local valueBox = create("Frame", {
		Size = UDim2.fromOffset(80, 20),
		Position = UDim2.new(1, -90, 0.5, -10),
		BackgroundColor3 = ELEMENT_COLOR,
		BorderSizePixel = 0,
	}, holder)

	create("UICorner", { CornerRadius = UDim.new(0, 4) }, valueBox)
	addStroke(valueBox, ACCENT_A, 0.5)

	local valueLabel = create("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = default,
		TextColor3 = TEXT_COLOR,
		TextSize = 12,
		Font = BOLD_FONT,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, valueBox)

	local index = 1
	for i, opt in ipairs(options) do
		if opt == default then index = i end
	end

	local function updateCycle()
		valueLabel.Text = options[index]
		TemplateHub.values[text] = options[index]
		if TemplateHub.featureCallbacks[text] then
			TemplateHub.featureCallbacks[text](options[index])
		end
		if callback then callback(options[index]) end
	end

	valueBox.MouseButton1Click:Connect(function()
		index = index % #options + 1
		updateCycle()
	end)

	updateCycle()
	TemplateHub.setters[text] = function(val)
		for i, opt in ipairs(options) do
			if opt == val then
				index = i
				break
			end
		end
		updateCycle()
	end
	TemplateHub.defaults[text] = default
	return holder, stroke
end

