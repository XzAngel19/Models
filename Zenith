---Module loading helper.
local moduleCache = {}
local function gameModule(service, ...)
	local key = service .. table.concat({ ... }, ".")
	if moduleCache[key] then return moduleCache[key] end

	local current = service
	for _, name in ipairs({ ... }) do
		current = current:WaitForChild(name)
	end

	local result = current
	moduleCache[key] = result
	return result
end

clientModule = function(name)
	return gameModule(localPlayer, "PlayerScripts", "Client", "Controllers", name)
end
local function sharedModule(name) return gameModule(replicatedStorage, "Shared", name) end
local function configModule(name) return gameModule(replicatedStorage, "Config", name) end

local function playerData()
	local data = clientModule("DataController"):GetPlayerData()
	if type(data) ~= "table" then error("Player data not ready") end
	return data
end

local function doCall(name, ...)
	local ok, result = callRemote(name, false, ...)
	if not ok then error(tostring(result)) end
	if type(result) ~= "table" or result.Ok ~= true then error(name .. ": unexpected response; stopped") end
	return result
end

-- No worker is allowed to overlap itself, even across quick off/on transitions.
local workers = {}
local function periodic(name, interval, callback, setup)
	TemplateHub.featureCallbacks[name] = function(enabled)
		if not enabled then return true end
		if workers[name] then return false, "Previous " .. name .. " call is still finishing" end
		if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
		local context
		if setup then
			local ok, value = pcall(setup)
			if not ok then return false, tostring(value) end
			context = value
		end
		workers[name] = true
		task.spawn(function()
			local ok, err = pcall(function()
				while TemplateHub.active and TemplateHub.values[name] do
					local success, result = pcall(callback, context)
					if not success then
						warn("Periodic " .. name .. " error: " .. tostring(result))
					end
					task.wait(interval)
				end
			end)
			if not ok then warn("Periodic " .. name .. " crashed: " .. tostring(err)) end
			workers[name] = false
		end)
		return true
	end
	return periodic
end

-- Predict mode logic: Predict which pet will be thrown based on current area/power
local function getPredictedPet()
	local data = playerData()
	local areaUtil = sharedModule("AreaUtil")
	local levels = configModule("Levels")
	local areas = configModule("Areas")
	local collections = configModule("Collections")
	local idx = sharedModule("IndexRewards")
	local gameConfig = configModule("GameConfig")

	local max = levels.ThrowPowerForLevel(tonumber(data.Level) or 1)
	local min = math.min(levels.MinThrowPower, max)
	local meter = TemplateHub.values["Auto Perfect"] and 1 or TemplateHub.values["Throw Power"]
	local bonus = (gameConfig.Throw.MeterBonusStuds or 0) * meter
	local selected, desired, selectedProgress
	
	-- Find best collection to throw at
	for i = 1, areaUtil.Count() do
		local area = areas.Get(i)
		if area then
			for _, collection in ipairs(collections) do
				if collection.Area == area.Key and idx.IsOpen(collection) and idx.IsUnlockedFor(data, collection) then
					local done, total = idx.Progress(data.Index, collection)
					local power = math.floor(math.clamp(areaUtil.DistanceToAreaCenter(i) - bonus, min, max) + 0.5)
					local _, landing = areaUtil.ComputeLanding(power + bonus, 0)
					if type(done) == "number" and type(total) == "number" and total > 0 and done < total and landing == i then
						local progress = done / total
						if not selected or (TemplateHub.values["Index Priority"] == "Most complete" and progress > selectedProgress) then
							selected, desired, selectedProgress = area.Key, power >= max and 0 or power, progress
						end
					end
				end
			end
		end
	end
	
	if selected then
		return areas.Get(selected).Name .. " (Power: " .. desired .. ")"
	else
		return "None (Too far or no target)"
	end
end

