		TemplateHub.values[text] = initial
		TemplateHub.defaults[text] = initial
		TemplateHub.setters[text] = function(value)
			if type(value) ~= "string" or #value > 200 then return end
			TemplateHub.values[text] = value
			box.Text = value
		end
		box.FocusLost:Connect(function() TemplateHub.setters[text](box.Text) end)
	end
	table.insert(TemplateHub.searchables, holder)
end

local function threshold(text)
	local value = string.lower((text or ""):gsub("%s", ""))
	if value == "" or value == "0" then return 0 end
	local num, suffix = value:match("^([%d%.]+)([kmbt]?)$")
	local multipliers = { [""] = 1, k = 1e3, m = 1e6, b = 1e9, t = 1e12 }
	local n = num and tonumber(num)
	if not n or n < 0 or n == math.huge then error("Invalid threshold: use a number or K/M/B/T") end
	return n * multipliers[suffix]
end
local function matchesText(input, value)
	input = (input or ""):lower():match("^%s*(.-)%s*$")
	if input == "" or input == "any" then return true end
	for term in input:gmatch("[^,]+") do
		if term:match("^%s*(.-)%s*$") == tostring(value or ""):lower() then return true end
	end
	return false
end
local function filters(prefix)
	return {
		mutation = TemplateHub.values[prefix .. " Mutation"], rarity = TemplateHub.values[prefix .. " Rarity"],
		animal = TemplateHub.values[prefix .. " Animals"], cps = threshold(TemplateHub.values[prefix .. " CPS"]),
		weight = threshold(TemplateHub.values[prefix .. " Weight"]),
	}
end
local function isRestricted(f)
	return f.cps > 0 or f.weight > 0 or not matchesText(f.mutation, "") or not matchesText(f.rarity, "") or not matchesText(f.animal, "")
end
local function sameFilters(a, b)
	return a.mutation == b.mutation and a.rarity == b.rarity and a.animal == b.animal and a.cps == b.cps and a.weight == b.weight
end
local function animalStats(entry)
	if type(entry) ~= "table" or type(entry.ModelName) ~= "string" then return nil end
	local economy, mutations = configModule("AnimalEconomy"), sharedModule("Mutations")
	local details = economy.Get(entry.ModelName)
	if type(details) ~= "table" or type(details.Rarity) ~= "string" then return nil end
	local income = mutations.IncomeOf(entry, localPlayer:GetAttribute("BestIncome") or 0)
	local weight = mutations.Weight(entry.ModelName, entry.Size)
	if type(income) ~= "number" or type(weight) ~= "number" then return nil end
	return { name = entry.ModelName, mutation = entry.Mutation or "Normal", rarity = details.Rarity, cps = income, weight = weight }
end
local function matchesAnimal(f, stats, above)
	if not stats or not matchesText(f.mutation, stats.mutation) or not matchesText(f.rarity, stats.rarity) or not matchesText(f.animal, stats.name) then return false end
	if above then return (f.cps == 0 or stats.cps > f.cps) and (f.weight == 0 or stats.weight > f.weight) end
	return (f.cps == 0 or stats.cps < f.cps) and (f.weight == 0 or stats.weight < f.weight)
end
local sellBusy = false
local function sellMatches(auto)
	if sellBusy then error("Sell already running") end
	local f = filters("Sell")
	if not isRestricted(f) then error("Set at least one sell filter first") end
	local animals = playerData().Animals
	if type(animals) ~= "table" then error("Animal inventory unavailable") end
	local mutations = sharedModule("Mutations")
	if type(mutations.EventOnlyNames) ~= "function" then error("Event protection unavailable") end
	sellBusy = true
	local ok, result = xpcall(function()
		local count = 0
		for id, entry in pairs(animals) do
			if not TemplateHub.active or (auto and not TemplateHub.values["Auto Sell"]) then break end
			local currentFilters = filters("Sell")
			if not sameFilters(currentFilters, f) then break end
			-- Re-read each animal so an inventory change cannot sell a stale entry.
			local current = playerData().Animals
			entry = type(current) == "table" and current[id] or nil
			if type(id) == "string" and type(entry) == "table" and not entry.Placed and not entry.Bought then
				local protected = mutations.EventOnlyNames(entry)
				if type(protected) == "table" and #protected == 0 and matchesAnimal(f, animalStats(entry), false) and TemplateHub.active and (not auto or TemplateHub.values["Auto Sell"]) and sameFilters(filters("Sell"), f) then
					doCall("Plot_SellAnimal", id)
					count += 1
					task.wait(0.5)
				end
			end
		end
		return count
	end, function(err) return tostring(err) end)
	sellBusy = false
	if not ok then error(result) end
	return result
end
periodic("Auto Sell", 10, function() sellMatches(true) end, function()
	if not isRestricted(filters("Sell")) then error("Set at least one sell filter first") end
end)
local function sellOnce()
	local ok, result = pcall(sellMatches, false)
	TemplateHub.report(ok and ("Sold " .. result .. " matching animals") or tostring(result), not ok)
end

local function webhookRequest(message)
	local url = secretWebhook:match("^%s*(.-)%s*$")
	-- Keep the URL/token out of settings, output, and error messages.
	if not url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$") then error("Enter a valid discord.com webhook URL") end
	local send = request or http_request or (type(syn) == "table" and syn.request)
	if type(send) ~= "function" then error("Executor HTTP request API unavailable") end
	local ok, response = pcall(send, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = httpService:JSONEncode({ content = message, allowed_mentions = { parse = {} } }) })
	if not ok then error("Webhook request failed") end
	local status = type(response) == "table" and (response.StatusCode or response.Status)
	if type(status) ~= "number" or status < 200 or status >= 300 then error("Webhook rejected or returned an unknown status") end
end
local function webhookSetup()
	if not secretWebhook:match("^%s*https://discord%.com/api/webhooks/%d+/[%w_%-]+%s*$") then error("Enter a valid discord.com webhook URL") end
	filters("Webhook")
	local animals = playerData().Animals
	if type(animals) ~= "table" then error("Animal inventory unavailable") end
	local seen = {}
	for id in pairs(animals) do seen[id] = true end
	return seen
end
periodic("Enable Webhook", 3, function(seen)
	local animals = playerData().Animals
	if type(animals) ~= "table" then error("Animal inventory unavailable") end
	local f = filters("Webhook")
	for id, entry in pairs(animals) do
		if not TemplateHub.active or not TemplateHub.values["Enable Webhook"] then break end
		if not seen[id] then
			seen[id] = true
			local stats = animalStats(entry)
			if matchesAnimal(f, stats, true) and TemplateHub.active and TemplateHub.values["Enable Webhook"] then
				webhookRequest(string.format("New animal: %s | %s | %s | CPS %.2f | Weight %.2f", stats.name, stats.mutation, stats.rarity, stats.cps, stats.weight))
				task.wait(1)
			end
		end
	end
end, webhookSetup)
local function testWebhook()
	local ok = pcall(webhookRequest, "Throw Food Hub webhook test.")
	TemplateHub.report(ok and "Webhook test sent" or "Webhook test failed; check URL and executor HTTP", not ok)
end

