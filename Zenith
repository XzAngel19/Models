	local selected = {}
	local expanded = false
	local rowButtons = {}
	TemplateHub.values[text] = selected
	TemplateHub.defaults[text] = {}

	local function updateSummary()
		local count, firstLabel = 0, nil
		for k, v in pairs(selected) do
			if v == true then
				count += 1
				if not firstLabel then firstLabel = k end
			end
		end
		local arrow = expanded and " ▴" or " ▾"
		if count == 0 then
			summaryLbl.Text = "Any" .. arrow
			summaryLbl.TextColor3 = DIM_TEXT_COLOR
		elseif count == 1 then
			summaryLbl.Text = tostring(firstLabel) .. arrow
			summaryLbl.TextColor3 = ACCENT_A
		else
			summaryLbl.Text = tostring(count) .. " selected" .. arrow
			summaryLbl.TextColor3 = ACCENT_A
		end
		for key, info in pairs(rowButtons) do
			local on = selected[key] == true
			info.check.Visible = on
			info.label.TextColor3 = on and TEXT_COLOR or OFF_TEXT_COLOR
		end
	end

	local function buildList()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(rowButtons)
		local opts = type(optionsProvider) == "function" and optionsProvider() or optionsProvider
		local query = string.lower((searchInput.Text or ""):match("^%s*(.-)%s*$"))
		for i, item in ipairs(opts) do
			local key = type(item) == "table" and item.key or tostring(item)
			local labelText = type(item) == "table" and item.label or tostring(item)
			if query == "" or string.find(string.lower(labelText), query, 1, true) or string.find(string.lower(key), query, 1, true) then
				local row = create("TextButton", {
					Size = UDim2.new(1, -4, 0, 22),
					BackgroundColor3 = ROW_COLOR,
					BackgroundTransparency = 0.45,
					BorderSizePixel = 0,
					Text = "",
					LayoutOrder = i,
					AutoButtonColor = false,
				}, scroll)
				create("UICorner", { CornerRadius = UDim.new(0, 3) }, row)
				local box = create("Frame", {
					Size = UDim2.fromOffset(12, 12),
					Position = UDim2.new(0, 6, 0.5, -6),
					BackgroundColor3 = ELEMENT_COLOR,
					BorderSizePixel = 0,
				}, row)
				create("UICorner", { CornerRadius = UDim.new(0, 3) }, box)
				addStroke(box, DIM_TEXT_COLOR, 0.4)
				local chk = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = ACCENT_A,
					BorderSizePixel = 0,
					Visible = selected[key] == true,
				}, box)
				create("UICorner", { CornerRadius = UDim.new(0, 2) }, chk)
				local lbl = create("TextLabel", {
					Size = UDim2.new(1, -26, 1, 0),
					Position = UDim2.fromOffset(24, 0),
					BackgroundTransparency = 1,
					Text = labelText,
					TextColor3 = selected[key] == true and TEXT_COLOR or OFF_TEXT_COLOR,
					TextSize = 12,
					Font = TEXT_FONT,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, row)
				rowButtons[key] = { check = chk, label = lbl }
				row.MouseButton1Click:Connect(function()
					if selected[key] then selected[key] = nil else selected[key] = true end
					updateSummary()
				end)
			end
		end
	end

	TemplateHub.setters[text] = function(value)
		table.clear(selected)
		if type(value) == "table" then
			for k, v in pairs(value) do
				if v == true and type(k) == "string" then selected[k] = true end
			end
		elseif type(value) == "string" and value ~= "" and string.lower(value) ~= "any" then
			for term in value:gmatch("[^,]+") do
				local trimmed = term:match("^%s*(.-)%s*$")
				if trimmed ~= "" then selected[trimmed] = true end
			end
		end
		updateSummary()
	end

	headerBtn.MouseButton1Click:Connect(function()
		expanded = not expanded
		if expanded then
			buildList()
		end
		panel.Visible = expanded
		tween(holder, FAST_TWEEN, { Size = UDim2.new(1, 0, 0, expanded and 204 or 30) })
		updateSummary()
	end)
	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		if expanded then buildList() end
	end)
	clearBtn.MouseButton1Click:Connect(function()
		table.clear(selected)
		updateSummary()
	end)

	updateSummary()
	table.insert(TemplateHub.searchables, holder)
end

local function getMutationOptions()
	local opts = { "Normal" }
	local seen = { Normal = true }
	local ok, cfg = pcall(configModule, "MutationsConfig")
	if ok and type(cfg.List) == "table" then
		for _, m in ipairs(cfg.List) do
			if type(m.Name) == "string" and not seen[m.Name] then
				seen[m.Name] = true
				table.insert(opts, m.Name)
			end
		end
	else
		for _, name in ipairs({ "Gold", "Diamond", "Emerald", "Ruby", "Rainbow", "Champion", "Lucid", "Gobble" }) do
			table.insert(opts, name)
		end
	end
	return opts
end

local function getRarityOptions()
	local opts = {}
	local ok, cfg = pcall(configModule, "RarityConfig")
	if ok and type(cfg.List) == "table" then
		for _, r in ipairs(cfg.List) do
			if type(r.Name) == "string" then table.insert(opts, r.Name) end
		end
	else
		opts = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Divine", "Celestial", "Eternal", "Cosmic", "Supreme", "Sovereign", "Astral" }
	end
	return opts
end

local function getAnimalOptions()
	local displayNames = {}
	local okData, animalsData = pcall(require, replicatedStorage:WaitForChild("AnimalsData", 2))
	if okData and type(animalsData) == "table" then
		for _, list in pairs(animalsData) do
			if type(list) == "table" then
				for _, entry in ipairs(list) do
					if type(entry.ModelName) == "string" and type(entry.Name) == "string" then
						displayNames[entry.ModelName] = entry.Name
					end
				end
			end
		end
	end
	local okTg, tgCfg = pcall(configModule, "ThanksgivingConfig")
	if okTg and type(tgCfg.Animals) == "table" then
		for _, entry in ipairs(tgCfg.Animals) do
			if type(entry.ModelName) == "string" and type(entry.Name) == "string" then
				displayNames[entry.ModelName] = entry.Name
			end
		end
		if type(tgCfg.Gobbler) == "table" and type(tgCfg.Gobbler.ModelName) == "string" then
			displayNames[tgCfg.Gobbler.ModelName] = tgCfg.Gobbler.Name or tgCfg.Gobbler.ModelName
		end
	end

	local opts = {}
	local seen = {}
	local okEcon, econ = pcall(configModule, "AnimalEconomy")
	if okEcon and type(econ.List) == "table" then
		for modelName in pairs(econ.List) do
			seen[modelName] = true
			local disp = displayNames[modelName]
			local label = (disp and disp ~= modelName) and (disp .. " (" .. modelName .. ")") or modelName
			table.insert(opts, { key = modelName, label = label })
		end
	end
	for modelName, disp in pairs(displayNames) do
		if not seen[modelName] then
			local label = (disp ~= modelName) and (disp .. " (" .. modelName .. ")") or modelName
			table.insert(opts, { key = modelName, label = label })
		end
	end
	table.sort(opts, function(a, b) return string.lower(a.label) < string.lower(b.label) end)
	return opts
end

local function hasSelections(tbl)
	if type(tbl) ~= "table" then return false end
	for _, v in pairs(tbl) do
		if v == true then return true end
	end
	return false
end
local function matchesSet(selectedSet, value)
	if not hasSelections(selectedSet) then return true end
	return selectedSet[tostring(value or "")] == true
end
local function filters(prefix)
	return {
		mutation = TemplateHub.values[prefix .. " Mutations"],
		rarity = TemplateHub.values[prefix .. " Rarities"],
		animal = TemplateHub.values[prefix .. " Animals"],
	}
end
local function isRestricted(f)
	return hasSelections(f.mutation) or hasSelections(f.rarity) or hasSelections(f.animal)
end
local function filterSignature(f)
	local parts = {}
	for _, tbl in ipairs({ f.mutation, f.rarity, f.animal }) do
		local keys = {}
		if type(tbl) == "table" then
			for k, v in pairs(tbl) do
				if v == true then table.insert(keys, k) end
			end
		end
		table.sort(keys)
		table.insert(parts, table.concat(keys, ","))
	end
	return table.concat(parts, "|")
end
local function animalStats(entry)
	if type(entry) ~= "table" or type(entry.ModelName) ~= "string" then return nil end
	local economy = configModule("AnimalEconomy")
	local details = economy.Get(entry.ModelName)
	if type(details) ~= "table" or type(details.Rarity) ~= "string" then return nil end
	return { name = entry.ModelName, mutation = entry.Mutation or "Normal", rarity = details.Rarity }
end
local function matchesAnimal(f, stats)
	return stats ~= nil and matchesSet(f.mutation, stats.mutation) and matchesSet(f.rarity, stats.rarity) and matchesSet(f.animal, stats.name)
end
local sellBusy = false
local function sellMatches(auto)
	if sellBusy then error("Sell already running") end
	local f = filters("Sell")
	if not isRestricted(f) then error("Select at least one sell filter first") end
	local sig = filterSignature(f)
	local animals = playerData().Animals
	if type(animals) ~= "table" then error("Animal inventory unavailable") end
	local mutations = sharedModule("Mutations")
	if type(mutations.EventOnlyNames) ~= "function" then error("Event protection unavailable") end
	sellBusy = true
	local ok, result = xpcall(function()
		local count = 0
		for id, entry in pairs(animals) do
			if not TemplateHub.active or (auto and not TemplateHub.values["Auto Sell"]) then break end
			if filterSignature(filters("Sell")) ~= sig then break end
			-- Re-read each animal so an inventory change cannot sell a stale entry.
			local current = playerData().Animals
			entry = type(current) == "table" and current[id] or nil
			if type(id) == "string" and type(entry) == "table" and not entry.Placed and not entry.Bought and not entry.Locked then
				local protected = mutations.EventOnlyNames(entry)
				if type(protected) == "table" and #protected == 0 and matchesAnimal(f, animalStats(entry)) and TemplateHub.active and (not auto or TemplateHub.values["Auto Sell"]) and filterSignature(filters("Sell")) == sig then
					doCall("Plot_SellAnimal", id)
					count += 1
					task.wait(0.5)
				end
			end
		end
		return count
	end, function(err) return tostring(err) end)
	sellBusy = false
	if not ok then error(result) end
	return result
end
periodic("Auto Sell", 10, function() sellMatches(true) end, function()
	if not isRestricted(filters("Sell")) then error("Select at least one sell filter first") end
end)
local function sellOnce()
	local ok, result = pcall(sellMatches, false)
	TemplateHub.report(ok and ("Sold " .. result .. " matching animals") or tostring(result), not ok)
end

