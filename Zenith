			targetRing.CFrame = CFrame.new(landPos + Vector3.new(0, 0.14, 0)) * CFrame.Angles(0, 0, math.pi / 2)

			local key = tostring(areaIdx) .. ":" .. tostring(subIdx) .. ":" .. tostring(math.floor(targetDist + 0.5)) .. ":" .. tostring(data.EquippedFood)
			if key ~= lastKey then
				lastKey = key
				titleLbl.Text = string.format("%s · %s (%d studs)", area and area.Name or ("Area " .. tostring(areaIdx)), sectionNames[subIdx] or tostring(subIdx), math.floor(targetDist + 0.5))
				local topLine = ""
				if okRoll and okFoods and okAnimals and area and type(animalsData[area.Key]) == "table" then
					local food = foodsCfg.Get(tonumber(data.EquippedFood) or 1) or foodsCfg.Get(1)
					local depth = areaUtil.DepthInArea(areaIdx, landPos.Z)
					local weights = food and animalRoll.Weights(food.Bait, areaIdx, depth)
					if type(weights) == "table" then
						local list = animalsData[area.Key]
						local ranked = {}
						for r = 1, #list do
							if (weights[r] or 0) > 0.01 then
								table.insert(ranked, { r = r, name = list[r].Name or list[r].ModelName, w = weights[r] })
							end
						end
						table.sort(ranked, function(a, b) return a.w > b.w end)
						local parts = {}
						for k = 1, math.min(3, #ranked) do
							table.insert(parts, string.format("#%d %s (%.0f%%)", ranked[k].r, ranked[k].name, ranked[k].w * 100))
						end
						topLine = table.concat(parts, " · ")
					end
				end
				subLbl.Text = topLine ~= "" and topLine or string.format("Target: %d studs (+%d bonus)", math.floor(targetDist + 0.5), math.floor(bonusMax + 0.5))
			end
		end)
	end)
	return true
end

