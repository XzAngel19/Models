-- Auto Index adjusts the game's persistent power setting before each farm throw.
-- The estimate follows PowerSlider's own predicted landing, but server rules may differ.
prepareIndex = function()
	local data = playerData()
	if type(data.Index) ~= "table" then error("Index data unavailable") end
	local idx = sharedModule("IndexRewards")
	local areas = configModule("AreasConfig")
	local areaUtil = sharedModule("AreaUtil")
	local levels = configModule("LevelConfig")
	local gameConfig = configModule("GameConfig")
	local collections = idx.Collections("World")
	if type(collections) ~= "table" then error("Index collections unavailable") end
	local max = levels.ThrowPowerForLevel(tonumber(data.Level) or 1)
	local min = math.min(levels.MinThrowPower, max)
	local meter = TemplateHub.values["Auto Perfect"] and 1 or TemplateHub.values["Throw Power"]
	local bonus = (gameConfig.Throw.MeterBonusStuds or 0) * meter
	local selected, desired, selectedProgress
	for i = 1, areaUtil.Count() do
		local area = areas.Get(i)
		if area then
			for _, collection in ipairs(collections) do
				if collection.Area == area.Key and idx.IsOpen(collection) and idx.IsUnlockedFor(data, collection) then
					local done, total = idx.Progress(data.Index, collection)
					local power = math.floor(math.clamp(areaUtil.DistanceToAreaCenter(i) - bonus, min, max) + 0.5)
					local _, landing = areaUtil.ComputeLanding(power + bonus, 0)
					if type(done) == "number" and type(total) == "number" and total > 0 and done < total and landing == i then
						local progress = done / total
						if not selected or (TemplateHub.values["Index Priority"] == "Most complete" and progress > selectedProgress) then
							selected, desired, selectedProgress = area.Key, power >= max and 0 or power, progress
						end
					end
				end
			end
		end
	end
	if not selected then error("No reachable incomplete world index area") end
	if TemplateHub.active and TemplateHub.values["Farm Animals"] and TemplateHub.values["Auto Index"] and (tonumber(data.ThrowPower) or 0) ~= desired then doCall("Player_SetThrowPower", desired) end
end
TemplateHub.featureCallbacks["Auto Index"] = function(enabled)
	if enabled and game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	return true
end

