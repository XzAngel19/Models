-- Movement: WalkSpeed and Fly (local-only, cleaned up on toggle off or GUI unload).
local walkSpeedConn, defaultWalkSpeed = nil, nil
local function restoreWalkSpeed()
	if walkSpeedConn then walkSpeedConn:Disconnect(); walkSpeedConn = nil end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and defaultWalkSpeed then
		pcall(function() hum.WalkSpeed = defaultWalkSpeed end)
	end
	defaultWalkSpeed = nil
end
local function setWalkSpeed(enabled)
	if not enabled then restoreWalkSpeed(); return true end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and not defaultWalkSpeed then defaultWalkSpeed = hum.WalkSpeed end
	if not walkSpeedConn then
		walkSpeedConn = runService.Heartbeat:Connect(function()
			if not TemplateHub.active or not TemplateHub.values["WalkSpeed"] then return end
			local c = localPlayer.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h then
				if not defaultWalkSpeed then defaultWalkSpeed = h.WalkSpeed end
				local target = tonumber(TemplateHub.values["WalkSpeed Value"]) or 32
				if h.WalkSpeed ~= target then h.WalkSpeed = target end
			end
		end)
	end
	return true
end

local flyConn, flyBV, flyBG = nil, nil, nil
local function restoreFly()
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	if flyBV and flyBV.Parent then flyBV:Destroy() end
	if flyBG and flyBG.Parent then flyBG:Destroy() end
	flyBV, flyBG = nil, nil
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
end
local function setFly(enabled)
	restoreFly()
	if not enabled then return true end
	flyConn = runService.RenderStepped:Connect(function()
		if not TemplateHub.active or not TemplateHub.values["Fly"] then restoreFly(); return end
		local char = localPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (hrp and hum and hum.Health > 0) then
			if flyBV and flyBV.Parent then flyBV:Destroy(); flyBV = nil end
			if flyBG and flyBG.Parent then flyBG:Destroy(); flyBG = nil end
			return
		end
		hum.PlatformStand = true
		if not (flyBV and flyBV.Parent == hrp) then
			if flyBV then flyBV:Destroy() end
			flyBV = Instance.new("BodyVelocity")
			flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			flyBV.P = 1250
			flyBV.Velocity = Vector3.zero
			flyBV.Parent = hrp
		end
		if not (flyBG and flyBG.Parent == hrp) then
			if flyBG then flyBG:Destroy() end
			flyBG = Instance.new("BodyGyro")
			flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
			flyBG.P = 9e4
			flyBG.D = 500
			flyBG.CFrame = hrp.CFrame
			flyBG.Parent = hrp
		end
		local cam = workspace.CurrentCamera
		local camCF = cam and cam.CFrame or hrp.CFrame
		flyBG.CFrame = camCF
		local move = Vector3.zero
		if not userInputService:GetFocusedTextBox() then
			if userInputService:IsKeyDown(Enum.KeyCode.W) then move += camCF.LookVector end
			if userInputService:IsKeyDown(Enum.KeyCode.S) then move -= camCF.LookVector end
			if userInputService:IsKeyDown(Enum.KeyCode.D) then move += camCF.RightVector end
			if userInputService:IsKeyDown(Enum.KeyCode.A) then move -= camCF.RightVector end
			if userInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
			if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) or userInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				move -= Vector3.new(0, 1, 0)
			end
		end
		local speed = tonumber(TemplateHub.values["Fly Speed"]) or 60
		flyBV.Velocity = move.Magnitude > 0 and (move.Unit * speed) or Vector3.zero
	end)
	return true
end

TemplateHub.restoreMovement = function()
	restoreWalkSpeed()
	restoreFly()
end
