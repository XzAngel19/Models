---Find a captured remote without loading game modules.
local function findRemote(name)
	if game.PlaceId ~= GAME_PLACE_ID then return nil, "Join Throw Food for Animals first." end
	local folder = replicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild(name)
	if not remote or remote.ClassName ~= remoteTypes[name] then
		return nil, name .. " missing or class changed"
	end
	return remote
end

---Make a captured call; unknown responses are not treated as verified success.
local function callRemote(name, allowInactive, ...)
	if not TemplateHub.active and not allowInactive then return false, "Menu closed" end
	local remote, reason = findRemote(name)
	if not remote then return false, reason end
	if remoteBusy[name] then return false, name .. " is already in flight" end
	remoteBusy[name] = true
	local args = table.pack(...)
	local ok, result = pcall(function()
		if remote.ClassName == "RemoteEvent" then
			remote:FireServer(table.unpack(args, 1, args.n))
			return nil
		end
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	remoteBusy[name] = nil
	if not ok then return false, name .. ": " .. tostring(result) end
	if type(result) == "table" and result.Ok == false then
		return false, name .. " rejected: " .. tostring(result.Reason or result.Message or result.Error or "Ok=false")
	end
	return true, result
end

---Wait in short intervals so an automation toggle can stop its worker.
local function waitEnabled(name, seconds)
	local deadline = os.clock() + seconds
	while TemplateHub.active and TemplateHub.values[name] and os.clock() < deadline do
