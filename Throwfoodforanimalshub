		TextSize = 12,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, headerBtn)
	local _, pointSummaryArrow = createArrow(headerBtn)

	local panel = create("Frame", {
		Size = UDim2.new(1, -12, 0, 166),
		Position = UDim2.fromOffset(6, 32),
		BackgroundColor3 = ELEMENT_COLOR,
