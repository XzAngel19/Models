---Farm the Thanksgiving event: chef chores plus sandwich throws aimed at missing event animals.
local thanksgivingWorker = false
local function setFarmThanksgiving(enabled)
	if not enabled then return true end
	if thanksgivingWorker then return false, "Previous event farm is still finishing" end
	if farmWorker or TemplateHub.values["Farm Animals"] then return false, "Stop Farm Animals first" end
	if trainWorker or TemplateHub.values["Auto Train"] then return false, "Stop Auto Train before farming" end
	for _, name in ipairs({ "Throw_Start", "Throw_MeterStarted", "Throw_Resolve", "Throw_Revealed", "Throw_Complete", "Throw_UseSandwich", "Thanksgiving_Action" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	local okEvent, isOpen = pcall(function()
		local thanksgiving = sharedModule("Thanksgiving")
		return thanksgiving.IsEligible(localPlayer) and thanksgiving.State().Open == true
	end)
	if not okEvent then return false, "Thanksgiving module unavailable" end
	if not isOpen then return false, "The Thanksgiving picnic is not open right now" end
	thanksgivingWorker = true
	task.spawn(function()
		local function keepGoing()
			return TemplateHub.active and TemplateHub.values["Farm Thanksgiving"] == true
		end
		local throws = 0
		local ok, message = xpcall(function()
			while keepGoing() do
				-- Chores first (claim rewards, cook sandwiches) so throws can use them.
				local cooked = chefDo("both")
				if not keepGoing() then break end

				local prepOk, sandwich = pcall(prepareThanksgivingIndex, true)
				if not prepOk then
					local why = tostring(sandwich)
					if why:find("complete", 1, true) then
						TemplateHub.report("Thanksgiving index complete - event farm stopped")
						break
					end
					error(why)
				end
				if cooked then
					-- Freshly cooked sandwich: let the server replicate it before throwing.
					if not waitStep(keepGoing, 1) then break end
				end

				-- No sandwich yet: a plain throw still earns ingredients/XP and keeps the loop alive.
				local threw, throwErr = throwOnce({ sandwich = sandwich, keepGoing = keepGoing })
				if not threw then
					if keepGoing() then error(throwErr or "Throw failed") end
					break
				end
				throws += 1
				if throws % 10 == 0 then
					local state = playerData().Thanksgiving
					local tg = sharedModule("Thanksgiving")
					if type(state) == "table" then
						TemplateHub.report(string.format("Thanksgiving: %d animals caught, %d sandwiches, %d ingredients",
							tg.UniqueCount(state) or 0, tg.TotalSandwiches(state) or 0, tg.TotalIngredients(state) or 0))
					end
				end
				if not waitStep(keepGoing, tonumber(TemplateHub.values["Farm Delay"]) or 3) then break end
			end
		end, function(err) return tostring(err) end)
		thanksgivingWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Farm Thanksgiving"](false)
			TemplateHub.report("Thanksgiving farm stopped: " .. tostring(message), true)
		end
	end)
	return true
end
