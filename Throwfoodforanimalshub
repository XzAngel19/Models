				if type(self) == "table" and self.Prompt and results[2] and results[2].Text then
					pcall(function() self.Prompt.Text = results[2].Text end)
				end
			end
			return table.unpack(results, 1, results.n)
		end
		meter.Run = patched
		table.insert(patchedMeterEntries, { mod = meter, original = orig, patched = patched })
	end
	return true
end

---Run the throw sequence with proper StarterArea positioning, cooldown waiting, retry handling, and training support.
-- Auto Equip Best bookkeeping (declared early: the farm requests a re-equip after every catch).
local equipState = { busy = false, lastOkAt = 0, lastAttemptAt = 0, want = false, wantAt = 0, failures = 0, lastCatchAt = 0 }
local requestEquip

-- Only one heavy action may run at a time: the game rejects overlapping throws,
-- training sessions and chef actions, and overlapping teleports broke the events.
local actionOwner = nil
local function actionAcquire(name, timeout)
	local deadline = os.clock() + (timeout or 25)
	while actionOwner and actionOwner ~= name and os.clock() < deadline do
		task.wait(0.05)
	end
	if actionOwner and actionOwner ~= name then return false end
	actionOwner = name
	return true
end
local function actionRelease(name)
	if actionOwner == name then actionOwner = nil end
end

---Wait in slices while the caller still wants to keep going.
local function waitStep(keepGoing, seconds)
	local deadline = os.clock() + math.max(0, tonumber(seconds) or 0)
	while os.clock() < deadline do
		if keepGoing and not keepGoing() then return false end
		task.wait(math.min(0.1, math.max(0, deadline - os.clock())))
	end
	return not keepGoing or keepGoing()
end

---The game refuses remote calls while its own ClientState.Busy is set (mid throw, cutscene...).
local function waitGameIdle(timeout)
	local ok, clientState = pcall(clientModule, "ClientState")
	if not ok or type(clientState) ~= "table" then return true end
	local deadline = os.clock() + (timeout or 8)
	local function busy()
		return type(clientState.Busy) == "string" and clientState.Busy ~= ""
	end
	while busy() and os.clock() < deadline do
		task.wait(0.1)
	end
	return not busy()
end

---Arm a sandwich before Throw_Start, the same order the in-game picker uses.
local function armSandwich(size)
	if type(size) ~= "string" or size == "" then return true end
