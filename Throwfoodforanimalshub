	local scroll = create("ScrollingFrame", {
		Size = UDim2.new(1, -8, 1, -34),
		Position = UDim2.fromOffset(4, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = ACCENT_B,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, panel)
	create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

	local selected = {}
	local expanded = false
	local rowButtons = {}
	TemplateHub.values[text] = selected
	TemplateHub.defaults[text] = {}

	local function updateSummary()
		local count, firstLabel = 0, nil
		for k, v in pairs(selected) do
			if v == true then
				count += 1
				if not firstLabel then firstLabel = k end
			end
		end
		pointSummaryArrow(expanded)
		if count == 0 then
			summaryLbl.Text = "Any"
			summaryLbl.TextColor3 = DIM_TEXT_COLOR
		elseif count == 1 then
			summaryLbl.Text = tostring(firstLabel)
			summaryLbl.TextColor3 = ACCENT_A
		else
			summaryLbl.Text = tostring(count) .. " selected"
			summaryLbl.TextColor3 = ACCENT_A
		end
		for key, info in pairs(rowButtons) do
			local on = selected[key] == true
			info.check.Visible = on
			info.label.TextColor3 = on and TEXT_COLOR or OFF_TEXT_COLOR
		end
	end

	local function buildList()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(rowButtons)
		local opts = type(optionsProvider) == "function" and optionsProvider() or optionsProvider
		local query = string.lower((searchInput.Text or ""):match("^%s*(.-)%s*$"))
		for i, item in ipairs(opts) do
			local key = type(item) == "table" and item.key or tostring(item)
			local labelText = type(item) == "table" and item.label or tostring(item)
			if query == "" or string.find(string.lower(labelText), query, 1, true) or string.find(string.lower(key), query, 1, true) then
				local row = create("TextButton", {
					Size = UDim2.new(1, -4, 0, 22),
					BackgroundColor3 = ROW_COLOR,
					BackgroundTransparency = 0.45,
					BorderSizePixel = 0,
					Text = "",
					LayoutOrder = i,
					AutoButtonColor = false,
				}, scroll)
				create("UICorner", { CornerRadius = UDim.new(0, 3) }, row)
				local box = create("Frame", {
					Size = UDim2.fromOffset(12, 12),
					Position = UDim2.new(0, 6, 0.5, -6),
					BackgroundColor3 = ELEMENT_COLOR,
					BorderSizePixel = 0,
				}, row)
				create("UICorner", { CornerRadius = UDim.new(0, 3) }, box)
				addStroke(box, DIM_TEXT_COLOR, 0.4)
				local chk = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = ACCENT_A,
					BorderSizePixel = 0,
					Visible = selected[key] == true,
				}, box)
				create("UICorner", { CornerRadius = UDim.new(0, 2) }, chk)
				local lbl = create("TextLabel", {
					Size = UDim2.new(1, -26, 1, 0),
					Position = UDim2.fromOffset(24, 0),
					BackgroundTransparency = 1,
					Text = labelText,
					TextColor3 = selected[key] == true and TEXT_COLOR or OFF_TEXT_COLOR,
					TextSize = 12,
					Font = TEXT_FONT,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, row)
				rowButtons[key] = { check = chk, label = lbl }
				row.MouseButton1Click:Connect(function()
					if selected[key] then selected[key] = nil else selected[key] = true end
					updateSummary()
				end)
			end
		end
	end

	TemplateHub.setters[text] = function(value)
		table.clear(selected)
		if type(value) == "table" then
			for k, v in pairs(value) do
				if v == true and type(k) == "string" then selected[k] = true end
			end
		elseif type(value) == "string" and value ~= "" and string.lower(value) ~= "any" then
			for term in value:gmatch("[^,]+") do
				local trimmed = term:match("^%s*(.-)%s*$")
				if trimmed ~= "" then selected[trimmed] = true end
			end
		end
		updateSummary()
	end

	headerBtn.MouseButton1Click:Connect(function()
		expanded = not expanded
		if expanded then
			buildList()
		end
		panel.Visible = expanded
		tween(holder, FAST_TWEEN, { Size = UDim2.new(1, 0, 0, expanded and 204 or 30) })
		updateSummary()
	end)
	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		if expanded then buildList() end
	end)
	clearBtn.MouseButton1Click:Connect(function()
		table.clear(selected)
		updateSummary()
	end)

	updateSummary()
	table.insert(TemplateHub.searchables, holder)
end

local function getMutationOptions()
	local opts = { "Normal" }
	local seen = { Normal = true }
	local ok, cfg = pcall(configModule, "MutationsConfig")
	if ok and type(cfg.List) == "table" then
		for _, m in ipairs(cfg.List) do
			if type(m.Name) == "string" and not seen[m.Name] then
				seen[m.Name] = true
				table.insert(opts, m.Name)
			end
		end
	else
		for _, name in ipairs({ "Gold", "Diamond", "Emerald", "Ruby", "Rainbow", "Champion", "Lucid", "Gobble" }) do
			table.insert(opts, name)
		end
	end
	return opts
end

local function getRarityOptions()
	local opts = {}
	local ok, cfg = pcall(configModule, "RarityConfig")
	if ok and type(cfg.List) == "table" then
		for _, r in ipairs(cfg.List) do
			if type(r.Name) == "string" then table.insert(opts, r.Name) end
		end
	else
		opts = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Divine", "Celestial", "Eternal", "Cosmic", "Supreme", "Sovereign", "Astral" }
	end
	return opts
end

local function getAnimalOptions()
	local displayNames = {}
	local okData, animalsData = pcall(require, replicatedStorage:WaitForChild("AnimalsData", 2))
	if okData and type(animalsData) == "table" then
		for _, list in pairs(animalsData) do
			if type(list) == "table" then
				for _, entry in ipairs(list) do
					if type(entry.ModelName) == "string" and type(entry.Name) == "string" then
						displayNames[entry.ModelName] = entry.Name
					end
				end
			end
		end
	end
	local okTg, tgCfg = pcall(configModule, "ThanksgivingConfig")
	if okTg and type(tgCfg.Animals) == "table" then
		for _, entry in ipairs(tgCfg.Animals) do
			if type(entry.ModelName) == "string" and type(entry.Name) == "string" then
				displayNames[entry.ModelName] = entry.Name
			end
		end
		if type(tgCfg.Gobbler) == "table" and type(tgCfg.Gobbler.ModelName) == "string" then
			displayNames[tgCfg.Gobbler.ModelName] = tgCfg.Gobbler.Name or tgCfg.Gobbler.ModelName
		end
	end

	local opts = {}
	local seen = {}
	local okEcon, econ = pcall(configModule, "AnimalEconomy")
	if okEcon and type(econ.List) == "table" then
		for modelName in pairs(econ.List) do
			seen[modelName] = true
			local disp = displayNames[modelName]
			local label = (disp and disp ~= modelName) and (disp .. " (" .. modelName .. ")") or modelName
			table.insert(opts, { key = modelName, label = label })
		end
	end
	for modelName, disp in pairs(displayNames) do
		if not seen[modelName] then
			local label = (disp ~= modelName) and (disp .. " (" .. modelName .. ")") or modelName
			table.insert(opts, { key = modelName, label = label })
		end
	end
	table.sort(opts, function(a, b) return string.lower(a.label) < string.lower(b.label) end)
	return opts
end

local function hasSelections(tbl)
	if type(tbl) ~= "table" then return false end
	for _, v in pairs(tbl) do
		if v == true then return true end
	end
	return false
end
local function matchesSet(selectedSet, value)
	if not hasSelections(selectedSet) then return true end
	return selectedSet[tostring(value or "")] == true
end
local function filters(prefix)
	return {
		mutation = TemplateHub.values[prefix .. " Mutations"],
		rarity = TemplateHub.values[prefix .. " Rarities"],
		animal = TemplateHub.values[prefix .. " Animals"],
	}
end
local function isRestricted(f)
	return hasSelections(f.mutation) or hasSelections(f.rarity) or hasSelections(f.animal)
end
local function filterSignature(f)
	local parts = {}
	for _, tbl in ipairs({ f.mutation, f.rarity, f.animal }) do
		local keys = {}
		if type(tbl) == "table" then
			for k, v in pairs(tbl) do
				if v == true then table.insert(keys, k) end
			end
		end
		table.sort(keys)
		table.insert(parts, table.concat(keys, ","))
	end
	return table.concat(parts, "|")
end
local function animalStats(entry)
	if type(entry) ~= "table" or type(entry.ModelName) ~= "string" then return nil end
	local economy = configModule("AnimalEconomy")
	local details = economy.Get(entry.ModelName)
	if type(details) ~= "table" or type(details.Rarity) ~= "string" then return nil end
	return { name = entry.ModelName, mutation = entry.Mutation or "Normal", rarity = details.Rarity }
end
local function matchesAnimal(f, stats)
	return stats ~= nil and matchesSet(f.mutation, stats.mutation) and matchesSet(f.rarity, stats.rarity) and matchesSet(f.animal, stats.name)
end
---The N most valuable animals (N = plot slots). While Equip Best is on these are never
---auto-sold, which is what used to delete rare pets when Equip Best failed silently.
local function mostValuableIds(slots)
	local okData, animals = pcall(function() return playerData().Animals end)
	if not okData or type(animals) ~= "table" then return nil end
	local okMut, mutations = pcall(sharedModule, "Mutations")
	local incomeOf = okMut and type(mutations) == "table" and mutations.IncomeOf or nil
	if type(incomeOf) ~= "function" then return nil end
	local scored = {}
	for id, entry in pairs(animals) do
		if type(id) == "string" and type(entry) == "table" then
			local okIncome, income = pcall(incomeOf, entry)
			table.insert(scored, { id = id, value = okIncome and (tonumber(income) or 0) or 0 })
		end
	end
	table.sort(scored, function(a, b) return a.value > b.value end)
	local protected = {}
	for i = 1, math.min(#scored, slots) do
		protected[scored[i].id] = true
	end
	return protected, #scored
end

local function plotSlotCount()
	local okFence, fence = pcall(configModule, "FenceConfig")
	if okFence and type(fence) == "table" and type(fence.SlotsFor) == "function" then
		local okData, data = pcall(playerData)
		local level = okData and type(data) == "table" and (tonumber(data.FenceLevel) or 0) or 0
		local okSlots, slots = pcall(fence.SlotsFor, level)
		if okSlots and type(slots) == "number" then return slots end
	end
	return 12
end

---(placedCount, lowest placed income, best unplaced income): used to prove the plot is
---really equipped before Auto Sell deletes anything.
local function plotState()
	local okData, animals = pcall(function() return playerData().Animals end)
	if not okData or type(animals) ~= "table" then return 0, math.huge, 0 end
	local okMut, mutations = pcall(sharedModule, "Mutations")
	local incomeOf = okMut and type(mutations) == "table" and mutations.IncomeOf or nil
	local placedCount, lowestPlaced, bestUnplaced = 0, math.huge, 0
	for _, entry in pairs(animals) do
		if type(entry) == "table" then
			local income = 0
			if type(incomeOf) == "function" then
				local okIncome, value = pcall(incomeOf, entry)
				income = okIncome and (tonumber(value) or 0) or 0
			end
			if entry.Placed then
				placedCount += 1
				lowestPlaced = math.min(lowestPlaced, income)
			else
				bestUnplaced = math.max(bestUnplaced, income)
			end
		end
	end
	return placedCount, lowestPlaced, bestUnplaced
end

-- ids that stayed unplaced long enough to be a real candidate (not mid-replication)
local sellSeen = {}
local function sellableNow(id)
	local now = os.clock()
	local firstSeen = sellSeen[id]
	if not firstSeen then
		sellSeen[id] = now
		return false
	end
	return now - firstSeen >= 1
end

local sellBusy = false
local function sellMatches(auto)
	if sellBusy then error("Sell already running") end
	local f = filters("Sell")
	if not isRestricted(f) then error("Select at least one sell filter first") end
	local sig = filterSignature(f)
	local animals = playerData().Animals
	if type(animals) ~= "table" then error("Animal inventory unavailable") end
	local mutations = sharedModule("Mutations")
	if type(mutations.EventOnlyNames) ~= "function" then error("Event protection unavailable") end

	-- Ordering guarantee: Auto Sell only runs on a plot that Equip Best just confirmed.
	if auto and TemplateHub.values["Auto Equip Best"] then
		if equipState.busy then return 0 end
		local equipOk, equipRes = equipBestOnce()
		if not equipOk then
			equipState.sellBlocked = (equipState.sellBlocked or 0) + 1
			if equipState.sellBlocked == 1 or equipState.sellBlocked % 6 == 0 then
				TemplateHub.report("Auto Sell on hold: Equip Best failed (" .. tostring(equipRes) .. ")", true)
			end
			return 0
		end
		equipState.sellBlocked = 0
		-- Give the server a moment to replicate the swap before touching the inventory.
		local settle = tonumber(TemplateHub.values["Sell Safety (s)"]) or 2
		if settle > 0 and not waitStep(function()
			return TemplateHub.active and (not auto or TemplateHub.values["Auto Sell"] == true)
		end, settle) then
			return 0
		end
		if equipState.busy or (equipState.failures or 0) > 0 then return 0 end

		-- Proof, not trust: the plot must actually show the animals Equip Best reported.
		local slots = plotSlotCount()
		local expected = math.min(tonumber(equipRes.Count) or 0, slots)
		local placedCount, lowestPlaced, bestUnplaced = plotState()
		if placedCount < expected then
			equipState.verifyBlocked = (equipState.verifyBlocked or 0) + 1
			if equipState.verifyBlocked == 1 or equipState.verifyBlocked % 6 == 0 then
				TemplateHub.report(string.format("Auto Sell on hold: plot shows %d/%d animals after Equip Best", placedCount, expected), true)
			end
			return 0
		end
		if placedCount > 0 and bestUnplaced > lowestPlaced then
			equipState.verifyBlocked = (equipState.verifyBlocked or 0) + 1
			if equipState.verifyBlocked == 1 or equipState.verifyBlocked % 6 == 0 then
				TemplateHub.report("Auto Sell on hold: a better animal is still off the plot", true)
			end
			-- Ask for another Equip Best and try again on the next pass.
			requestEquip()
			return 0
		end
		equipState.verifyBlocked = 0
	end

	-- Value protection only applies to the automatic pass; "Sell Match" stays manual.
	local guardedIds, animalCount = nil, nil
	if auto and TemplateHub.values["Auto Equip Best"] then
		local slots = plotSlotCount()
		guardedIds, animalCount = mostValuableIds(slots)
		-- Everything the player owns already fits on the plot: nothing is safe to sell.
		if guardedIds and animalCount and animalCount <= slots then
			equipState.allProtected = (equipState.allProtected or 0) + 1
			if equipState.allProtected == 1 or equipState.allProtected % 12 == 0 then
				TemplateHub.report("Auto Sell: every animal fits on the plot, so nothing is sold")
			end
			return 0
		end
	end

	sellBusy = true
	local ok, report = xpcall(function()
		local count, blocked = 0, 0
		for id, entry in pairs(animals) do
			if not TemplateHub.active or (auto and not TemplateHub.values["Auto Sell"]) then break end
			if filterSignature(filters("Sell")) ~= sig then break end
			-- Re-read each animal so an inventory change cannot sell a stale entry.
			local current = playerData().Animals
			entry = type(current) == "table" and current[id] or nil
			if type(id) ~= "string" or type(entry) ~= "table" then
				sellSeen[id] = nil
			elseif entry.Placed or entry.Bought or entry.Locked then
				sellSeen[id] = nil
			elseif guardedIds and guardedIds[id] then
				blocked += 1
			elseif not sellableNow(id) then
				blocked += 1
			else
				local protected = mutations.EventOnlyNames(entry)
				local wanted = type(protected) == "table" and #protected == 0 and matchesAnimal(f, animalStats(entry))
				if wanted and TemplateHub.active and (not auto or TemplateHub.values["Auto Sell"]) and filterSignature(filters("Sell")) == sig then
					local sellOk, sellRes = callRemote("Plot_SellAnimal", false, id)
					if sellOk then
						count += 1
						sellSeen[id] = nil
						task.wait(0.45)
					else
						local why = tostring(sellRes)
						if why:find("Placed", 1, true) or why:find("TooFast", 1, true) or why:find("Locked", 1, true)
							or why:find("Busy", 1, true) or why:find("Protected", 1, true) or why:find("NotOwned", 1, true) then
							sellSeen[id] = nil
							blocked += 1
						else
							error(why)
						end
					end
				end
			end
		end
		return { count = count, blocked = blocked }
	end, function(err) return tostring(err) end)
	sellBusy = false
	if not ok then error(report) end
	return report.count, report.blocked
end
local function sellOnce()
	local ok, result = pcall(sellMatches, false)
	TemplateHub.report(ok and ("Sold " .. result .. " matching animals") or tostring(result), not ok)
end

