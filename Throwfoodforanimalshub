resilientWorker("Auto Equip Best", 1, function()
	local now = os.clock()
	local interval = tonumber(TemplateHub.values["Equip Delay"]) or 30
	local due = (equipState.want and now >= equipState.wantAt)
		or (now - equipState.lastAttemptAt) >= interval
		or equipState.lastAttemptAt <= 0
	if not due then return end
	equipState.want = false
	-- Let the catch we just resolved replicate into Animals before re-equipping.
	if now - (equipState.lastCatchAt or 0) < 0.6 then return end
	local ok, result = equipBestOnce()
	if not ok then
		-- Retry a couple of times before waiting the full Equip Delay.
		if equipState.failures <= 3 then
			equipState.want = true
			equipState.wantAt = now + 4
		end
		if equipState.failures % 4 == 1 then
			TemplateHub.report("Equip Best failed: " .. tostring(result), true)
		end
		return
	end
	local placed, removed = equipState.lastPlaced or 0, equipState.lastRemoved or 0
	if placed + removed > 0 then
		TemplateHub.report(string.format("Equip Best: %d placed, %d swapped", placed, removed))
	end
end)
