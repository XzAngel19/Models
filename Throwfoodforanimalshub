---Hook InvokeServer once so Throw_Resolve results can be read (Auto Perfect + Instantly View Throw).
local function ensureInvokeHook()
	if invokeHookInstalled or type(hookfunction) ~= "function" then return end
	local ok, rf = pcall(Instance.new, "RemoteFunction")
	if not ok or not rf then return end
	local fn = rf.InvokeServer
	pcall(function() rf:Destroy() end)
	if type(fn) ~= "function" then return end

	local function onInvokeServer(self, ...)
		if typeof(self) == "Instance" and self:IsA("RemoteFunction") and self.Name == "Throw_Resolve" then
			local res
			if TemplateHub.active and TemplateHub.values["Auto Perfect"] then
				res = originalInvokeServer(self, 1)
			else
				res = originalInvokeServer(self, ...)
			end
			if captureThrowResult then captureThrowResult(res) end
			return res
		end
		return originalInvokeServer(self, ...)
	end

	local hookOk, orig = pcall(hookfunction, fn, onInvokeServer)
	if hookOk and type(orig) == "function" then
		originalInvokeServer = orig
		invokeHookInstalled = true
	elseif captureThrowResult then
		-- Some executors hand back a per-instance closure; the namecall hook below covers that.
		-- Fall back to hooking the single remote instance.
		local remote = findRemote("Throw_Resolve")
		local original = remote and remote.InvokeServer
		if type(original) == "function" then
			local directOrig
			local directOk
			directOk, directOrig = pcall(hookfunction, original, function(self, ...)
				local res = directOrig(self, ...)
				captureThrowResult(res)
				return res
			end)
			if directOk then
				originalInvokeServer = type(directOrig) == "function" and directOrig or original
				invokeHookInstalled = true
			end
		end
	end
end

-- Last-resort capture: every InvokeServer is a namecall, so this route works even
-- when hookfunction only reaches a single instance closure.
local namecallHookInstalled = false
local function ensureNamecallHook()
	if namecallHookInstalled or type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
		return namecallHookInstalled
	end
	local ok = pcall(function()
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			local results = table.pack(oldNamecall(self, ...))
			if method == "InvokeServer" and typeof(self) == "Instance" and self.Name == "Throw_Resolve" and captureThrowResult then
				captureThrowResult(results[1])
			end
			return table.unpack(results, 1, results.n)
		end)
	end)
	if ok then namecallHookInstalled = true end
	return namecallHookInstalled
end

-- Patch ThrowMeter.Run (locking meter + returning 1.0 + PERFECT rating) and hook InvokeServer when available.
