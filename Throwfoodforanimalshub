---One chef interaction: talk, then claim a reward or cook a sandwich.
---Returns (didSomething, message, fatal). Rate limited so the server never sees a spam burst.
local chefCooldown = 0
local function chefDo(mode)
	local okTg, thanksgiving = pcall(sharedModule, "Thanksgiving")
	if not okTg or type(thanksgiving) ~= "table" then return false, "Thanksgiving module unavailable", true end
	local okData, state = pcall(function() return playerData().Thanksgiving end)
	if not okData or type(state) ~= "table" then return false, "Thanksgiving data unavailable" end
	local okState, eventState = pcall(thanksgiving.State)
	if not okState or type(eventState) ~= "table" or eventState.Open ~= true then
		return false, "The picnic is closed right now"
	end
	if os.clock() < chefCooldown then return false, nil end

	local action, actionSize = nil, nil
	if (mode == "claim" or mode == "both") and (tonumber(thanksgiving.RewardsPending(state)) or 0) > 0 then
		action = "Claim"
	elseif mode == "cook" or mode == "both" then
		local size = TemplateHub.values["Cook Size"]
		if size == "Best" then
			for _, candidate in ipairs({ "Mega", "Big", "Regular" }) do
				if thanksgiving.CanCook(state, candidate) then size = candidate; break end
			end
		end
		if size ~= "Best" and size ~= nil and thanksgiving.CanCook(state, size) then
			action, actionSize = "Cook", size
		end
	end
	if not action then return false, nil end

	if not actionAcquire("chef", 30) then return false, "Another action is still running" end
	waitGameIdle(6)
	local chefCF, chefErr = getTurkeyChefCFrame()
	if not chefCF then
		actionRelease("chef")
		return false, chefErr or "Turkey Chef not found"
	end
	local moveOk, callOk, callRes = withCharacterAt(chefCF, function()
		if type(state) == "table" and state.Talked ~= true then
			callRemote("Thanksgiving_Action", false, "Talked")
		end
		if action == "Cook" then
			return callRemote("Thanksgiving_Action", false, "Cook", actionSize)
		end
		return callRemote("Thanksgiving_Action", false, "Claim")
	end)
	actionRelease("chef")
	chefCooldown = os.clock() + 10

	if not moveOk then return false, tostring(callOk), true end
	if callOk then return true, action end

	local why = tostring(callRes)
	if why:find("TooFast", 1, true) or why:find("Cooldown", 1, true) or why:find("Wait", 1, true) then
		chefCooldown = os.clock() + 8
		return false, nil
	end
	if why:find("NotEnough", 1, true) or why:find("Nothing", 1, true) or why:find("Closed", 1, true)
		or why:find("Empty", 1, true) or why:find("Max", 1, true) then
		chefCooldown = os.clock() + 12
		return false, nil
	end
	if why:find("TooFar", 1, true) or why:find("Busy", 1, true) then
		return false, nil
	end
	return false, why, true
end

