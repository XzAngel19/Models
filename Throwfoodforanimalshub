		end)

		TemplateHub.pages[name] = page
		TemplateHub.tabButtons[name] = button
		TemplateHub.tabIndex[name] = index
	end

	-- Main: throw, training, animal and reward features.
	local mainLeft = createColumn(TemplateHub.pages.Main, UDim2.fromOffset(0, 0))
	local mainRight = createColumn(TemplateHub.pages.Main, UDim2.new(0.5, 6, 0, 0))

	addSection(mainLeft, "Throw")
	addToggle(mainLeft, "Auto Perfect", nil, false)
	addToggle(mainLeft, "Instant Throw", nil, false)
	addSection(mainLeft, "Training")
	addToggle(mainLeft, "Auto Train", nil, false)
	addToggle(mainLeft, "Auto 2x Press", nil, false)
	addSection(mainRight, "Equip Animals")
	addToggle(mainRight, "Auto Equip Best", nil, false)
	addSlider(mainRight, "Equip Delay", 5, 120, 30, 0)
	addSection(mainRight, "Rewards")
	addToggle(mainRight, "Auto Claim Index Rewards", nil, false)
	addToggle(mainRight, "Auto Equip Best Trails", nil, false)
	addDropdown(mainRight, "Trail Priority", { "Xp", "Cash" }, "Xp")

	-- Extra: the observed farming sequence and reference features awaiting data.
	local extraLeft = createColumn(TemplateHub.pages.Extra, UDim2.fromOffset(0, 0))
	local extraRight = createColumn(TemplateHub.pages.Extra, UDim2.new(0.5, 6, 0, 0))
	addSection(extraLeft, "Farm")
	addToggle(extraLeft, "Farm Animals", nil, false)
	addSlider(extraLeft, "Meter Delay", 0.1, 20, 1.5, 1)
	addSlider(extraLeft, "Reveal Delay", 0.1, 30, 8, 1)
	addSlider(extraLeft, "Complete Delay", 0.1, 30, 14, 1)
	addSlider(extraLeft, "Farm Delay", 0.1, 60, 3, 1)
	addCycle(extraLeft, "Index Priority", { "First incomplete", "Most complete" })
	addToggle(extraLeft, "Auto Index", nil, false)
	addToggle(extraLeft, "Train Between Farms", nil, false)
	addSlider(extraLeft, "Train After Throws", 1, 100, 10, 0)
	addSlider(extraLeft, "Train for(s)", 1, 300, 30, 0)
	addSection(extraLeft, "Thanksgiving")
	addToggle(extraLeft, "Farm Thanksgiving", nil, false)
	addToggle(extraLeft, "Auto Thanksgiving Index", nil, false)
	addToggle(extraLeft, "Auto Cook Sandwich", nil, false)
	addToggle(extraLeft, "Auto Event (claim chef rewards)", nil, false)
	addDropdown(extraLeft, "Cook Size", { "Best", "Regular", "Big", "Mega" }, "Best")

	addSection(extraRight, "Movement")
	addToggle(extraRight, "WalkSpeed", nil, false)
	addSlider(extraRight, "WalkSpeed Value", 16, 200, 32, 0)
	addToggle(extraRight, "Fly", nil, false)
	addSlider(extraRight, "Fly Speed", 20, 300, 60, 0)
	addSection(extraRight, "Upgrades")
	addToggle(extraRight, "Auto Upgrade Bars", nil, false)
	addToggle(extraRight, "Auto Upgrade Plot", nil, false)
	addToggle(extraRight, "Auto Upgrade Food", nil, false)
	addButton(extraRight, "Upgrade Stand", function()
		task.spawn(function()
			local ok, result = callRemote("Stand_Upgrade", false)
			if ok then
				TemplateHub.report(type(result) == "table" and result.Ok == true and "Stand upgrade accepted" or "Stand call returned; check game")
			else
				TemplateHub.report(tostring(result), true)
			end
		end)
	end)
	addSection(extraRight, "Selling (filters are AND)")
	addSlider(extraRight, "Sell Safety (s)", 0, 30, 2, 0)
	addMultiDropdown(extraRight, "Sell Mutations", getMutationOptions)
	addMultiDropdown(extraRight, "Sell Rarities", getRarityOptions)
	addMultiDropdown(extraRight, "Sell Animals", getAnimalOptions)
	addButton(extraRight, "Sell Match", function()
		local valid, f = pcall(filters, "Sell")
		if not valid or not isRestricted(f) then
			return TemplateHub.report(valid and "Select at least one sell filter first" or tostring(f), true)
		end
		task.spawn(sellOnce)
	end)
	addToggle(extraRight, "Auto Sell", nil, false)

	-- Visuals are local-only and restored when disabled or unloaded.
	local visualsLeft = createColumn(TemplateHub.pages.Visuals, UDim2.fromOffset(0, 0))
	local visualsRight = createColumn(TemplateHub.pages.Visuals, UDim2.new(0.5, 6, 0, 0))
	addSection(visualsLeft, "Environment")
	addToggle(visualsLeft, "Fullbright", nil, false)
	addSection(visualsRight, "Game Visuals")
	addToggle(visualsRight, "Instantly View Throw", nil, false)
	addToggle(visualsRight, "Animal ESP", nil, false)

	-- Config tab.
	local configLeft = createColumn(TemplateHub.pages.Config, UDim2.fromOffset(0, 0))
	local configRight = createColumn(TemplateHub.pages.Config, UDim2.new(0.5, 6, 0, 0))

	local statusLabel = create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 18),
		Position = UDim2.new(0, 4, 1, -20),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = DIM_TEXT_COLOR,
		TextSize = 12,
		Font = TEXT_FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
	}, TemplateHub.pages.Config)

	---Show a short status message.
	local function setStatus(message)
		statusLabel.Text = message
		statusLabel.TextTransparency = 0

		task.delay(3, function()
			if statusLabel.Text == message then
				tween(statusLabel, MEDIUM_TWEEN, { TextTransparency = 1 })
			end
		end)
	end

	---Save every setting to a file.
	local function saveSettings()
		if not writefile then
			return setStatus("Saving is not supported here.")
		end

		local ok, result = pcall(function()
			if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end

			writefile(CONFIG_FILE, httpService:JSONEncode(TemplateHub.values))
		end)

		setStatus(ok and "Settings saved." or ("Save failed: " .. tostring(result)))
	end

	---Load every setting from the file.
	local function loadSettings()
		if not (readfile and isfile and isfile(CONFIG_FILE)) then
			return setStatus("No saved settings found.")
		end

		local ok, data = pcall(function()
			return httpService:JSONDecode(readfile(CONFIG_FILE))
		end)

		if not ok or typeof(data) ~= "table" then
			return setStatus("Settings file is corrupted.")
		end

		local safeVisuals = { Fullbright = true, ["Instantly View Throw"] = true, ["Animal ESP"] = true }
		for name, value in data do
			-- Never start actions just because a settings file was loaded.
			if TemplateHub.featureCallbacks[name] and not safeVisuals[name] then value = false end
			local setter = TemplateHub.setters[name]

			if setter then
				pcall(setter, value)
			end
		end

		setStatus("Settings loaded.")
	end

	---Reset every setting to its default.
	local function resetSettings()
		for name, value in TemplateHub.defaults do
			TemplateHub.setters[name](value)
		end

		setStatus("Settings reset.")
	end

	addSection(configLeft, "Settings")
	addButton(configLeft, "Save Settings", saveSettings)
	addButton(configLeft, "Load Settings", loadSettings)
	addButton(configLeft, "Reset Settings", resetSettings)
	addButton(configLeft, "Copy Settings", function()
		if not setclipboard then
			return setStatus("Clipboard is not supported here.")
		end

		setclipboard(httpService:JSONEncode(TemplateHub.values))
		setStatus("Settings copied.")
	end)
	addToggle(configLeft, "Auto Save", nil, false)

	addSection(configRight, "Interface")
	addCycle(configRight, "Menu Keybind", { "RightShift", "Insert", "RightControl", "Delete", "End" })
	addButton(configRight, "Reset Window", function()
		windowWidth, windowHeight = WINDOW_WIDTH, WINDOW_HEIGHT
		minimized = false
		TemplateHub.resizeHandle.Visible = true

		tween(window, MEDIUM_TWEEN, {
			Size = UDim2.fromOffset(windowWidth, windowHeight),
			Position = UDim2.new(0.5, -windowWidth / 2, 0.5, -windowHeight / 2),
		})
	end)
	addButton(configRight, "Unload GUI", function()
		tween(windowScale, FAST_TWEEN, { Scale = 0 }).Completed:Connect(function()
			screenGui:Destroy()
		end)
	end)

	-- Apply the menu keybind and autosave when enabled.
	task.spawn(function()
		while screenGui.Parent do
			local keyName = TemplateHub.values["Menu Keybind"]
			TemplateHub.menuKey = Enum.KeyCode.RightShift

			for _, item in Enum.KeyCode:GetEnumItems() do
				if item.Name == keyName then
					TemplateHub.menuKey = item
					break
				end
			end

			if TemplateHub.values["Auto Save"] and writefile then
				pcall(function()
					if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
						makefolder(CONFIG_FOLDER)
					end

					writefile(CONFIG_FILE, httpService:JSONEncode(TemplateHub.values))
				end)
			end

			task.wait(5)
		end
	end)

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(searchBox.Text)

		for _, element in TemplateHub.searchables do
			element.Visible = (query == "" or string.find(string.lower(element.Name), query, 1, true) ~= nil) and not element:GetAttribute("GroupHidden")
		end

		for _, section in TemplateHub.sections do
			section.Visible = query == ""
		end

		for _, box in TemplateHub.boxes do
			local anyVisible = query == ""

			for _, child in box:GetChildren() do
				if child:IsA("GuiObject") and child.Visible and not table.find(TemplateHub.sections, child) then
					anyVisible = true
					break
				end
			end

			box.Visible = anyVisible
		end
	end)

	-- The menu keybind hides and shows the menu.
	connectInput(userInputService.InputBegan, function(input, gameProcessed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		-- A keybind button is waiting for the next key.
		if TemplateHub.listening then
			return TemplateHub.listening(input.KeyCode)
		end

		if gameProcessed then
			return
		end

		if input.KeyCode == TemplateHub.menuKey then
			screenGui.Enabled = not screenGui.Enabled
			return
		end

		-- Toggle any feature bound to this key.
		for featureName, keyCode in TemplateHub.keybinds do
			if keyCode == input.KeyCode then
				TemplateHub.setters[featureName](not TemplateHub.values[featureName])
				TemplateHub.notify(featureName, TemplateHub.values[featureName])
			end
		end
	end)

	-- Keybind Hints shows or hides the keybind labels.
	task.spawn(function()
		while screenGui.Parent do
			local visible = TemplateHub.values["Keybind Hints"] ~= false

			for _, keybindButton in TemplateHub.keyLabels do
				keybindButton.Visible = visible
			end

			task.wait(0.5)
		end
	end)

	switchTab("Main")
end

---Called when initialization errors.
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
end

xpcall(initializeScript, onInitializeError)
