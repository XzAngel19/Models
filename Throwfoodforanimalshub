local function isRemotesModuleTable(t)
	return type(rawget(t, "Invoke")) == "function"
		and type(rawget(t, "Function")) == "function"
		and type(rawget(t, "Event")) == "function"
end

-- Result capture uses every route the game can take to Throw_Resolve, because a
-- single hook is not reliable across executors: InvokeServer hook, Remotes.Invoke
-- patch and RevealSequence.Run. Whichever fires first shows the banner.
local resolveLayers = { invokeHook = false, namecall = false, remotesPatch = 0, revealPatch = false }

local revealWrappers = {}
local function ensureRevealResultCapture()
	local reveals = collectModuleTables(clientModule, "RevealSequence", isRevealSequenceTable)
	if #reveals == 0 then return false end
	for _, rs in ipairs(reveals) do
		-- Re-wrap only when another patch (Instant Throw) replaced our wrapper.
		if rs.Run ~= revealWrappers[rs] and type(rs.Run) == "function" then
			local orig = rs.Run
			local patched = function(params, ...)
				if type(params) == "table" and type(params.Result) == "table" and captureThrowResult then
					captureThrowResult(params.Result)
				end
				return orig(params, ...)
			end
			rs.Run = patched
			revealWrappers[rs] = patched
		end
	end
	resolveLayers.revealPatch = true
	return true
end

-- Fallback for executors where no hook can be installed: watch the inventory that the
-- server replicates and announce animals that were not there before (throws only).
local inventoryWatchThread
local function stopInventoryWatch()
	if inventoryWatchThread then
		pcall(task.cancel, inventoryWatchThread)
		inventoryWatchThread = nil
	end
end

local function startInventoryWatch()
	stopInventoryWatch()
	local known = {}
	local function scan(seed)
		local ok, data = pcall(playerData)
		local animals = ok and type(data) == "table" and data.Animals or nil
		if type(animals) ~= "table" then return end
		for id, entry in pairs(animals) do
			if not known[id] then
				known[id] = true
				if not seed and type(entry) == "table" and entry.Bought ~= true and type(entry.ModelName) == "string" then
					if captureThrowResult then
						captureThrowResult({
							Ok = true,
							ModelName = entry.ModelName,
							Mutation = entry.Mutation,
							Size = entry.Size,
							Income = entry.Income,
						})
					end
				end
			end
		end
	end
	scan(true)
	inventoryWatchThread = task.spawn(function()
		while TemplateHub.active and TemplateHub.values["Instantly View Throw"] do
			task.wait(0.4)
			scan(false)
		end
		inventoryWatchThread = nil
	end)
end

local function setInstantlyViewThrow(enabled)
	cleanupInstantViewThrow()
	stopInventoryWatch()
	if not enabled then return true end
	if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end

	-- Auto Perfect may already have installed the InvokeServer hook; reuse it.
	if not invokeHookInstalled then ensureInvokeHook() end
	resolveLayers.invokeHook = invokeHookInstalled
	resolveLayers.namecall = ensureNamecallHook()

	resolveLayers.remotesPatch = 0
	local remotesOk, remotesMods = pcall(collectModuleTables, sharedModule, "Remotes", isRemotesModuleTable)
	if remotesOk and type(remotesMods) == "table" then
		for _, rm in ipairs(remotesMods) do
			local orig = rm.Invoke
			local patched = function(name, ...)
				local res = orig(name, ...)
				if name == "Throw_Resolve" and captureThrowResult then
					captureThrowResult(res)
				end
				return res
			end
			-- A frozen module table rejects the assignment; other layers still work.
			local patchedOk = pcall(function()
				rm.Invoke = patched
			end)
			if patchedOk and rm.Invoke == patched then
				table.insert(patchedRemotesInvoke, { mod = rm, original = orig, patched = patched })
				resolveLayers.remotesPatch += 1
			end
		end
	end

	pcall(ensureRevealResultCapture)

	local layers = {}
	if resolveLayers.invokeHook then table.insert(layers, "invoke") end
	if resolveLayers.namecall then table.insert(layers, "namecall") end
	if resolveLayers.remotesPatch > 0 then table.insert(layers, "remotes") end
	if resolveLayers.revealPatch then table.insert(layers, "reveal") end
	if #layers == 0 then
		-- No hooks at all: still show the banner from replicated inventory changes.
		startInventoryWatch()
		if TemplateHub.report then
			TemplateHub.report("Instant view armed: inventory watch (no hooks in this executor)")
		end
		return true
	end

	if TemplateHub.report then
		TemplateHub.report("Instant view armed: " .. table.concat(layers, " + "))
	end

	return true
end

local animalEspFolder, animalEspConns = nil, {}
local function cleanupAnimalEsp()
