end

---Full throw cycle: line, start, sandwich, meter, resolve, reveal, complete.
---Returns true when the server accepted every step.
local function throwOnce(opts)
	opts = opts or {}
	local keepGoing = opts.keepGoing or function() return TemplateHub.active end
	if not actionAcquire("throw", 30) then
		return false, "Another action is still running"
	end
	waitGameIdle(6)

	local hrp, hrpErr = getCharacterRoot()
	if not hrp then
		actionRelease("throw")
		return false, hrpErr or "Character unavailable"
	end
	local savedCF = hrp.CFrame

	local pending = false
	local ok, message = xpcall(function()
		local lineCF, lineErr = getThrowLineCFrame(false)
		if not lineCF then error(lineErr or "Throw line unavailable") end

		-- Stay on the line for the whole sequence, exactly like a player standing there.
		moveRootTo(hrp, lineCF)
		task.wait(0.15)

		local startOk, startResult = false, nil
		for attempt = 1, 3 do
			startOk, startResult = callRemote("Throw_Start", false)
			if startOk and type(startResult) == "table" and startResult.Ok == true then break end

			local why = tostring(startResult)
			if why:find("TooFar", 1, true) and attempt == 1 then
				local crossCF = getThrowLineCFrame(true)
				if crossCF then
					moveRootTo(hrp, crossCF)
					task.wait(0.2)
				end
			elseif why:find("Cooldown", 1, true) or why:find("Wait", 1, true) then
				local readyAt = localPlayer:GetAttribute("ThrowReadyAt")
				local waitFor = type(readyAt) == "number" and (readyAt - workspace:GetServerTimeNow() + 0.15) or 1
				if not waitStep(keepGoing, math.min(math.max(waitFor, 0.3), 6)) then return end
			elseif why:find("Already", 1, true) or why:find("InProgress", 1, true) or why:find("Busy", 1, true) then
				callRemote("Throw_Cancel", true, "Reset")
				if not waitStep(keepGoing, 0.4) then return end
			else
				break
			end
			if not keepGoing() then return end
		end
		if not (startOk and type(startResult) == "table" and startResult.Ok == true) then
			error(tostring(startResult))
		end
		pending = true

		if opts.sandwich then
			local armed, armErr = armSandwich(opts.sandwich)
			if not armed then error("Sandwich rejected: " .. tostring(armErr)) end
		end

		local meterOk, meterRes = callRemote("Throw_MeterStarted", false)
		if not meterOk then error(tostring(meterRes)) end
		if not waitStep(keepGoing, tonumber(TemplateHub.values["Meter Delay"]) or 1.5) then return end

		-- Power 1 = full meter (+MeterBonusStuds); Auto Perfect makes the game agree.
		local resolveOk, resolveResult = callRemote("Throw_Resolve", false, 1)
		if not resolveOk or type(resolveResult) ~= "table" or resolveResult.Ok ~= true then
			error(tostring(resolveResult))
		end
		if captureThrowResult then captureThrowResult(resolveResult) end

		local flight = tonumber(resolveResult.FlightTime) or 0
		local revealWait = math.max(tonumber(TemplateHub.values["Reveal Delay"]) or 8, flight + 0.8)
		if not waitStep(keepGoing, revealWait) then return end

		local revealOk, revealRes = callRemote("Throw_Revealed", false)
		if not revealOk then error(tostring(revealRes)) end

		-- Throw_Complete is gated by the reveal duration on the server. With Instant Throw the
		-- animation is skipped locally, so start sooner and let the retries find the window.
		local completeWait = tonumber(TemplateHub.values["Complete Delay"]) or 14
		if TemplateHub.values["Instant Throw"] then
			completeWait = math.min(completeWait, math.max(2, flight + 1))
		end
		if not waitStep(keepGoing, completeWait) then return end

		local completeOk, completeResult = false, nil
		local completeDeadline = os.clock() + 20
		while os.clock() < completeDeadline and keepGoing() do
			completeOk, completeResult = callRemote("Throw_Complete", false)
			if completeOk and type(completeResult) == "table" and completeResult.Ok == true then break end
			local why = tostring(completeResult)
			if why:find("NotActive", 1, true) or why:find("NoThrow", 1, true) or why:find("Expired", 1, true)
				or why:find("Invalid", 1, true) then
				break
			end
			if not waitStep(keepGoing, 2) then break end
		end
		if not (completeOk and type(completeResult) == "table" and completeResult.Ok == true) then
			error(tostring(completeResult))
		end
		pending = false
	end, function(err) return tostring(err) end)

	if pending then callRemote("Throw_Cancel", true) end
	if hrp and hrp.Parent then moveRootTo(hrp, savedCF) end
	actionRelease("throw")
	if not ok then return false, message end
	return true
end

---Training is driven by the game's own controller so the server session, camera,
---tap bonuses and XP popup all behave like a real training run.
local function getTrainingController()
	local ok, mod = pcall(clientModule, "TrainingController")
	if ok and type(mod) == "table" and type(mod.Start) == "function" then return mod end
	return nil
end

---Centre of LocalPlotProps.TrainingArea (the circle pollCircle checks) + 3 studs.
local function trainingCirclePoint()
	local okSpot, spotPos, _halfSize = pcall(getTrainingSpotInfo)
	if okSpot and typeof(spotPos) == "Vector3" then
		return spotPos + Vector3.new(0, 3, 0)
	end
	local plotPos, err = getPlotBasePos()
	if not plotPos then return nil, err end
	local okCfg, cfg = pcall(configModule, "GameConfig")
	local offset = okCfg and cfg.Plot and cfg.Plot.TrainingSpotOffset or Vector3.new(-16, 0.5, -30.5)
	local okVector = pcall(function() return plotPos + offset end)
	return (okVector and (plotPos + offset) or plotPos) + Vector3.new(0, 3, 0)
end

---Run one training session and stop it cleanly. Returns true when the server started it.
local function runTrainingSession(seconds, keepGoing)
	keepGoing = keepGoing or function() return TemplateHub.active end
	local okData, data = pcall(playerData)
	if not okData or type(data) ~= "table" then return false, "Player data unavailable" end
	if (tonumber(data.Stand) or 0) < 1 then return false, "Buy a pull-up bar first" end

	local point, pointErr = trainingCirclePoint()
	if not point then return false, pointErr or "Training spot unavailable" end
	if not actionAcquire("train", 30) then return false, "Another action is still running" end

	local hrp, hrpErr = getCharacterRoot()
	if not hrp then
		actionRelease("train")
		return false, hrpErr or "Character unavailable"
	end
	local savedCF = hrp.CFrame
	local controller = getTrainingController()

	local finished, message = xpcall(function()
		-- Step into the circle; the game's pollCircle starts training from there.
		moveRootTo(hrp, CFrame.new(point))
		task.wait(0.25)
		if controller and not (controller.IsRunning and controller.IsRunning()) then
			task.spawn(function() pcall(controller.Start) end)
		end

		local started = false
		for _ = 1, 50 do
			if localPlayer:GetAttribute("Training") == true then started = true; break end
			if controller and controller.IsRunning and controller.IsRunning() then started = true; break end
			if not keepGoing() then break end
			task.wait(0.1)
		end
		if not started then
			local startedOk, startedRes = callRemote("Training_Start", false)
			if not startedOk or type(startedRes) ~= "table" or startedRes.Ok ~= true then
				error(tostring(startedRes))
			end
		end

		local deadline = os.clock() + math.max(3, tonumber(seconds) or 30)
		while os.clock() < deadline and keepGoing() do
			task.wait(0.1)
		end
	end, function(err) return tostring(err) end)

	-- Unwind the game's session, then step out of the circle so it cannot restart.
	if controller and type(controller.Stop) == "function" then pcall(controller.Stop, true) end
	for _ = 1, 30 do
		if localPlayer:GetAttribute("Training") ~= true then break end
		task.wait(0.1)
	end
	if localPlayer:GetAttribute("Training") == true then callRemote("Training_Stop", true) end
	local char = getCharacterRoot()
	if char then moveRootTo(char, savedCF) end
	task.wait(0.25)
	actionRelease("train")

	if not finished then return false, message end
	return true
end

local function setFarm(enabled)
	if not enabled then return true end
	if farmWorker then return false, "Previous farm run is still finishing" end
	if TemplateHub.values["Farm Thanksgiving"] then return false, "Stop Farm Thanksgiving first" end
	if trainWorker or TemplateHub.values["Auto Train"] then return false, "Stop Auto Train before farming" end
	for _, name in ipairs({ "Throw_Start", "Throw_MeterStarted", "Throw_Resolve", "Throw_Revealed", "Throw_Complete" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	farmWorker = true
	task.spawn(function()
		local function keepGoing()
			return TemplateHub.active and TemplateHub.values["Farm Animals"] == true
		end
		local throwCount = 0
		local ok, errorMessage = xpcall(function()
			while keepGoing() do
				-- Wait out the throw cooldown before asking for a new throw.
				local readyAt = localPlayer:GetAttribute("ThrowReadyAt")
				if type(readyAt) == "number" then
					local waitLeft = readyAt - workspace:GetServerTimeNow()
					if waitLeft > 0 and not waitEnabled("Farm Animals", waitLeft + 0.1) then break end
				end
				if localPlayer:GetAttribute("Training") == true then
					callRemote("Training_Stop", true)
					if not waitEnabled("Farm Animals", 0.3) then break end
				end

				-- Pick the throw target before moving, so a missing target never wastes a throw.
				local sandwich = nil
				if TemplateHub.values["Auto Thanksgiving Index"] then
					local tgOk, tgSandwich = pcall(prepareThanksgivingIndex)
					if tgOk then
						sandwich = tgSandwich
						if not sandwich then
							TemplateHub.report("Thanksgiving Index: no sandwiches - cook at the chef (or use Farm Thanksgiving)")
							TemplateHub.setters["Auto Thanksgiving Index"](false)
						end
					else
						TemplateHub.report("Thanksgiving Index: " .. tostring(tgSandwich), true)
						TemplateHub.setters["Auto Thanksgiving Index"](false)
					end
				elseif TemplateHub.values["Auto Index"] then
					local idxOk, idxErr = pcall(prepareIndex)
					if not idxOk then TemplateHub.report("Auto Index: " .. tostring(idxErr), true) end
				end
				if not keepGoing() then break end

				local threw, throwErr = throwOnce({ sandwich = sandwich, keepGoing = keepGoing })
				if not threw then
					if keepGoing() then error(throwErr or "Throw failed") end
					break
				end
				throwCount += 1

				-- Re-equip after every catch so Auto Sell never sees a half-moved plot.
				if TemplateHub.values["Auto Equip Best"] then requestEquip() end

				if TemplateHub.values["Train Between Farms"]
					and throwCount >= (tonumber(TemplateHub.values["Train After Throws"]) or 30) then
					throwCount = 0
					local trained, trainErr = runTrainingSession(tonumber(TemplateHub.values["Train for(s)"]) or 30, keepGoing)
					if not trained then
						TemplateHub.report("Train between farms: " .. tostring(trainErr), true)
						TemplateHub.setters["Train Between Farms"](false)
					end
				end

				if not waitEnabled("Farm Animals", TemplateHub.values["Farm Delay"]) then break end
			end
		end, function(err) return tostring(err) end)
		farmWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Farm Animals"](false)
			TemplateHub.report("Farm stopped: " .. tostring(errorMessage), true)
		end
	end)
	return true
end

---Keep training running until the toggle is turned off.
local function setAutoTrain(enabled)
	if not enabled then return true end
	if trainWorker then return false, "Previous training call is still finishing" end
	if farmWorker or TemplateHub.values["Farm Animals"] or TemplateHub.values["Farm Thanksgiving"] then
		return false, "Stop farming before training"
	end
	for _, name in ipairs({ "Training_Start", "Training_Stop" }) do
		local remote, reason = findRemote(name)
		if not remote then return false, reason end
	end
	local okData, data = pcall(playerData)
	if okData and type(data) == "table" and (tonumber(data.Stand) or 0) < 1 then
		return false, "Buy a pull-up bar first"
	end
	trainWorker = true
	task.spawn(function()
		local ok, message = xpcall(function()
			while TemplateHub.active and TemplateHub.values["Auto Train"] do
				local trained, trainErr = runTrainingSession(60, function()
					return TemplateHub.active and TemplateHub.values["Auto Train"] == true
				end)
				if not trained then error(trainErr) end
				task.wait(0.5)
			end
		end, function(err) return tostring(err) end)
		trainWorker = false
		if not ok and TemplateHub.active then
			TemplateHub.setters["Auto Train"](false)
			TemplateHub.report("Training stopped: " .. tostring(message), true)
		end
	end)
	return true
end

