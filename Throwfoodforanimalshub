-- Game module access follows the paths found in the provided client export.
-- We only require modules already present in the live place, and validate the API.
local moduleCache = {}
local function gameModule(root, ...)
	local path = table.pack(...)
	local key = tostring(root) .. ":" .. table.concat(path, ".")
	if moduleCache[key] then return moduleCache[key] end
	local object = root
	for i = 1, path.n do
		object = object and object:FindFirstChild(path[i])
	end
	if not object or not object:IsA("ModuleScript") then error("Game module missing: " .. table.concat(path, ".")) end
	local ok, result = pcall(require, object)
	if not ok or type(result) ~= "table" then error("Game module unavailable: " .. table.concat(path, ".")) end
	moduleCache[key] = result
	return result
end
clientModule = function(name)
	return gameModule(localPlayer, "PlayerScripts", "Client", "Controllers", name)
end
sharedModule = function(name) return gameModule(replicatedStorage, "Shared", name) end
configModule = function(name) return gameModule(replicatedStorage, "Config", name) end
playerData = function()
	local data = clientModule("DataController"):GetPlayerData()
	if type(data) ~= "table" then error("Player data not ready") end
	return data
end
doCall = function(name, ...)
	local ok, result = callRemote(name, false, ...)
	if not ok then error(tostring(result)) end
	if type(result) ~= "table" or result.Ok ~= true then error(name .. ": unexpected response; stopped") end
	return result
end

-- No worker is allowed to overlap itself, even across quick off/on transitions.
local workers = {}
local function periodic(name, interval, callback, setup)
	TemplateHub.featureCallbacks[name] = function(enabled)
		if not enabled then return true end
		if workers[name] then return false, "Previous " .. name .. " call is still finishing" end
		if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
		local context
		if setup then
			local ok, value = pcall(setup)
			if not ok then return false, tostring(value) end
			context = value
		end
		workers[name] = true
		task.spawn(function()
			local ok, message = xpcall(function()
				while TemplateHub.active and TemplateHub.values[name] do
					callback(context)
					if not waitEnabled(name, type(interval) == "function" and interval() or interval) then break end
				end
			end, function(err) return tostring(err) end)
			workers[name] = nil
			if not ok and TemplateHub.active then
				TemplateHub.setters[name](false)
				TemplateHub.report(name .. " stopped: " .. message, true)
			end
		end)
		return true
	end
end

---Like periodic(), but a refusal is reported instead of turning the toggle off:
---Equip Best, the chef and the event farm can all be rejected temporarily by the server.
local function resilientWorker(name, interval, callback)
	TemplateHub.featureCallbacks[name] = function(enabled)
		if not enabled then return true end
		if workers[name] then return false, "Previous " .. name .. " call is still finishing" end
		if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
		workers[name] = true
		task.spawn(function()
			while TemplateHub.active and TemplateHub.values[name] do
				local ok, message = pcall(callback)
				if not ok then
					if not TemplateHub.active then break end
					TemplateHub.report(name .. ": " .. tostring(message), true)
					if not waitEnabled(name, 3) then break end
				end
				if not waitEnabled(name, type(interval) == "function" and interval() or interval) then break end
			end
			workers[name] = nil
		end)
		return true
	end
end

-- Instant Throw auto-taps the meter, collapses flight arc duration, skips RevealSequence, and suppresses ScreenFX white/black fades.
local instantMeterEntries = {}
local function restoreInstant()
	for _, entry in ipairs(instantMeterEntries) do
		if entry.mod then entry.mod.TestAutoTap = entry.oldAutoTap end
	end
	table.clear(instantMeterEntries)
	for _, entry in ipairs(patchedArcEntries) do
		if entry.mod and entry.mod.CreateArc == entry.patched then entry.mod.CreateArc = entry.original end
	end
	table.clear(patchedArcEntries)
	for _, entry in ipairs(patchedRevealEntries) do
		if entry.mod and entry.mod.Run == entry.patched then entry.mod.Run = entry.original end
	end
	table.clear(patchedRevealEntries)
	for _, entry in ipairs(patchedScreenFXEntries) do
		if entry.mod and entry.mod[entry.key] == entry.patched then
			entry.mod[entry.key] = entry.original
		end
	end
	table.clear(patchedScreenFXEntries)
end
TemplateHub.restoreInstant = restoreInstant

TemplateHub.featureCallbacks["Instant Throw"] = function(enabled)
	if not enabled then restoreInstant(); return true end
	if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	restoreInstant()
	local meters = collectModuleTables(clientModule, "ThrowMeter", isThrowMeterTable)
	if #meters == 0 then return false, "ThrowMeter module unavailable" end
	for _, meter in ipairs(meters) do
		table.insert(instantMeterEntries, { mod = meter, oldAutoTap = meter.TestAutoTap })
		meter.TestAutoTap = 0.05
	end
	local arcs = collectModuleTables(sharedModule, "ProjectileMath", isProjectileMathTable)
	for _, pm in ipairs(arcs) do
		local orig = pm.CreateArc
		local patched = function(p1, p2, dur, grav)
			if TemplateHub.active and TemplateHub.values["Instant Throw"] then
				return orig(p1, p2, 0.05, nil)
			end
			return orig(p1, p2, dur, grav)
		end
		pm.CreateArc = patched
		table.insert(patchedArcEntries, { mod = pm, original = orig, patched = patched })
	end
	local screenFXList = collectModuleTables(clientModule, "ScreenFX", isScreenFXTable)
	for _, sf in ipairs(screenFXList) do
		pcall(sf.Reset)
		for _, fnName in ipairs({ "FadeOut", "FadeIn", "Cover", "Flash" }) do
			local orig = sf[fnName]
			if type(orig) == "function" then
				local patched = function(...)
					if TemplateHub.active and TemplateHub.values["Instant Throw"] then
						pcall(sf.Reset)
						return nil
					end
					return orig(...)
				end
				sf[fnName] = patched
				table.insert(patchedScreenFXEntries, { mod = sf, key = fnName, original = orig, patched = patched })
			end
		end
	end
	local reveals = collectModuleTables(clientModule, "RevealSequence", isRevealSequenceTable)
	for _, rs in ipairs(reveals) do
		local orig = rs.Run
		local patched = function(...)
			if TemplateHub.active and TemplateHub.values["Instant Throw"] then
				for _, sf in ipairs(screenFXList) do pcall(sf.Reset) end
				return nil
			end
			return orig(...)
		end
		rs.Run = patched
		table.insert(patchedRevealEntries, { mod = rs, original = orig, patched = patched })
	end
	return true
end

---Auto 2x Press: the server broadcasts Training_Bonus [repIndex, fireTime, 2] a few
---seconds before the tap window opens. The in-game button lives from that moment until
---fireTime, so we claim right away through the game's own button (keeps the x2 popup and
---the ExtraReps roll) and fall back to the remote if the button is not there.
local bonusConnection = nil
local bonusClaimed = {}
local bonusStats = { claimed = 0, failed = 0 }
TemplateHub.bonusStats = bonusStats

local function findTapButton()
	local pgui = localPlayer:FindFirstChild("PlayerGui")
	if not pgui then return nil end
	local seq = pgui:FindFirstChild("TrainingSequence")
	local layer = seq and seq:FindFirstChild("TapBonusLayer")
	local button = layer and layer:FindFirstChild("TapBonus")
	if button and button:IsA("GuiButton") then return button end
	local deep = pgui:FindFirstChild("TapBonus", true)
	if deep and deep:IsA("GuiButton") then return deep end
	return nil
end

local function claimTapBonus(id, key)
	if bonusClaimed[key] then return true end
	bonusClaimed[key] = true

	-- Preferred path: the game's own claim (x2 popup, screen flash, extra reps).
	local button = findTapButton()
	if button and type(firesignal) == "function" then
		local fired = pcall(firesignal, button.Activated)
		if fired then
			bonusStats.claimed += 1
			return true
		end
	end

	local ok, result = callRemote("Training_TapBonus", false, id)
	if ok then
		bonusStats.claimed += 1
		if button and button.Parent then pcall(function() button:Destroy() end) end
		return true
	end

	local why = tostring(result)
	-- The server only accepts a bonus once it is the live one: retry when it says so.
	if why:find("Early", 1, true) or why:find("Wait", 1, true) or why:find("Ready", 1, true) then
		bonusClaimed[key] = nil
	elseif why:find("Expired", 1, true) or why:find("Claimed", 1, true) or why:find("Used", 1, true) then
		return true
	else
		bonusStats.failed += 1
		if bonusStats.failed % 5 == 1 then
			TemplateHub.report("2x press: " .. why, true)
		end
	end
	return false
end

TemplateHub.featureCallbacks["Auto 2x Press"] = function(enabled)
	if bonusConnection then
		bonusConnection:Disconnect()
		bonusConnection = nil
	end
	if not enabled then return true end
	local event, reason = findRemote("Training_Bonus")
	if not event then return false, reason end
	local tapRemote, tapReason = findRemote("Training_TapBonus")
	if not tapRemote then return false, tapReason end

	if localPlayer:GetAttribute("Training") ~= true then
		TemplateHub.report("Auto 2x Press is armed - it fires during training (turn on Auto Train)")
	end

	bonusConnection = event.OnClientEvent:Connect(function(id, fireTime)
		if not TemplateHub.active or not TemplateHub.values["Auto 2x Press"] then return end
		if type(id) ~= "number" then return end
		if type(fireTime) ~= "number" or fireTime <= workspace:GetServerTimeNow() then return end
		-- Rep indexes repeat between sessions: the key is the bonus id + its fire time.
		local key = tostring(id) .. "@" .. string.format("%.2f", fireTime)
		local count = 0
		for _ in pairs(bonusClaimed) do count += 1 end
		if count > 200 then table.clear(bonusClaimed) end
		task.spawn(function()
			-- Let TrainingController build its button first, then claim like a player would.
			local window = math.max(0, fireTime - workspace:GetServerTimeNow())
			for _ = 1, 6 do
				if not TemplateHub.active or not TemplateHub.values["Auto 2x Press"] then return end
				if findTapButton() then break end
				if workspace:GetServerTimeNow() >= fireTime then break end
				task.wait(math.min(0.1, math.max(0.02, window / 20)))
			end
			if not TemplateHub.active or not TemplateHub.values["Auto 2x Press"] then return end
			if claimTapBonus(id, key) then return end
			-- Rejected: retry once when the bonus actually goes live.
			local waitLeft = fireTime - workspace:GetServerTimeNow()
			if waitLeft > 0 and waitLeft < 6 then
				task.wait(waitLeft + 0.05)
				if TemplateHub.active and TemplateHub.values["Auto 2x Press"] then
					claimTapBonus(id, key)
				end
			end
		end)
	end)
	table.insert(TemplateHub.connections, bonusConnection)
	return true
end

-- Auto Index adjusts the game's persistent power setting before each farm throw.
prepareIndex = function()
	local data = playerData()
	if type(data.Index) ~= "table" then error("Index data unavailable") end
	local idx = sharedModule("IndexRewards")
	local areas = configModule("AreasConfig")
	local areaUtil = sharedModule("AreaUtil")
	local levels = configModule("LevelConfig")
	local gameConfig = configModule("GameConfig")
	local collections = idx.Collections("World")
	if type(collections) ~= "table" then error("Index collections unavailable") end
	local max = levels.ThrowPowerForLevel(tonumber(data.Level) or 1)
	local min = math.min(levels.MinThrowPower, max)
	local bonus = gameConfig.Throw.MeterBonusStuds or 20
	local selected, desired, selectedProgress
	for i = 1, areaUtil.Count() do
		local area = areas.Get(i)
		if area then
			for _, collection in ipairs(collections) do
				if collection.Area == area.Key and idx.IsOpen(collection) and idx.IsUnlockedFor(data, collection) then
					local done, total = idx.Progress(data.Index, collection)
					local power = math.floor(math.clamp(areaUtil.DistanceToAreaCenter(i) - bonus, min, max) + 0.5)
					local _, landing = areaUtil.ComputeLanding(power + bonus, 0)
					if type(done) == "number" and type(total) == "number" and total > 0 and done < total and landing == i then
						local progress = done / total
						if not selected or (TemplateHub.values["Index Priority"] == "Most complete" and progress > selectedProgress) then
							selected, desired, selectedProgress = area.Key, power >= max and 0 or power, progress
						end
					end
				end
			end
		end
	end
	if not selected then error("No reachable incomplete world index area") end
	if TemplateHub.active and TemplateHub.values["Farm Animals"] and TemplateHub.values["Auto Index"] and (tonumber(data.ThrowPower) or 0) ~= desired then doCall("Player_SetThrowPower", desired) end
end
TemplateHub.featureCallbacks["Auto Index"] = function(enabled)
	if enabled and game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	return true
end

-- Auto Thanksgiving Index picks missing Thanksgiving animals, sets throw power to their zone/section, and arms a sandwich.
prepareThanksgivingIndex = function(force)
	local data = playerData()
	local tg = sharedModule("Thanksgiving")
	local tgCfg = configModule("ThanksgivingConfig")
	if not tg.IsEligible(localPlayer) or tg.State().Open ~= true then
		error("Thanksgiving picnic is not open")
	end
	local tgState = type(data.Thanksgiving) == "table" and data.Thanksgiving or {}
	local index = type(data.Index) == "table" and data.Index or {}
	local areas = configModule("AreasConfig")
	local areaUtil = sharedModule("AreaUtil")
	local levels = configModule("LevelConfig")
	local gameConfig = configModule("GameConfig")
	local max = levels.ThrowPowerForLevel(tonumber(data.Level) or 1)
	local min = math.min(levels.MinThrowPower, max)
	local bonus = gameConfig.Throw.MeterBonusStuds or 20
	local launchZ = areaUtil.GetLaunchPosition().Z
	local targetPower = nil
	for _, animal in ipairs(tgCfg.Animals) do
		if index[animal.ModelName] ~= true then
			local area = areas.ByKey and areas.ByKey[animal.Zone]
			if area and areas.IsPlayable(area) then
				local depth = animal.Section == 3 and 0.85 or 0.5
				local targetZ = area.ZStart - (area.ZStart - area.ZEnd) * depth
				local targetDist = launchZ - targetZ
				local power = math.floor(math.clamp(targetDist - bonus, min, max) + 0.5)
				local landPos, landingArea = areaUtil.ComputeLanding(power + bonus, 0)
				if landingArea == area.Index then
					local sub = areaUtil.SubAreaForZ(area.Index, landPos.Z)
					if not animal.Section or sub >= animal.Section then
						targetPower = power >= max and 0 or power
						break
					end
				end
			end
		end
	end
	if not targetPower and tgState.GobblerCaught ~= true then
		local area = areas.ByKey and areas.ByKey[tgCfg.Gobbler.Zone]
		if area and areas.IsPlayable(area) then
			local power = math.floor(math.clamp(areaUtil.DistanceToAreaCenter(area.Index) - bonus, min, max) + 0.5)
			local _, landingArea = areaUtil.ComputeLanding(power + bonus, 0)
			if landingArea == area.Index then
				targetPower = power >= max and 0 or power
			end
		end
	end
	if not targetPower then error("Thanksgiving index complete - nothing left to catch") end
	-- Throw power is what the server uses for the distance, so set it before the throw.
	local farmRunning = TemplateHub.values["Farm Animals"] or TemplateHub.values["Farm Thanksgiving"]
	if (force or (TemplateHub.active and farmRunning)) and (tonumber(data.ThrowPower) or 0) ~= targetPower then
		doCall("Player_SetThrowPower", targetPower)
	end
	-- Best sandwich we own (may be nil: the event farm still throws to earn ingredients).
	local chosenSandwich = nil
	for _, size in ipairs({ "Mega", "Big", "Regular" }) do
		if tg.SandwichCount(tgState, size) > 0 then
			chosenSandwich = size
			break
		end
	end
	return chosenSandwich, targetPower
end
