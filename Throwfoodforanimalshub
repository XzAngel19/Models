	end
	return TemplateHub.active and TemplateHub.values[name]
end

---Find live module tables via require and optional getgc fallback.
local function collectModuleTables(loaderFn, moduleName, signatureCheck)
	local found = {}
	local seen = {}
	local ok, mod = pcall(loaderFn, moduleName)
	if ok and type(mod) == "table" and signatureCheck(mod) then
		seen[mod] = true
		table.insert(found, mod)
	end
	if type(getgc) == "function" then
		local gcOk, gcList = pcall(getgc, true)
		if gcOk and type(gcList) == "table" then
			for _, obj in ipairs(gcList) do
				if type(obj) == "table" and not seen[obj] and signatureCheck(obj) then
					seen[obj] = true
					table.insert(found, obj)
				end
			end
		end
	end
	return found
end

