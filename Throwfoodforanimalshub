	if type(res) ~= "table" or res.Ok ~= true then return end
	local now = os.clock()
	local key = table.concat({
		tostring(res.ModelName or res.DisplayName),
		tostring(res.Mutation),
		tostring(res.Size),
		tostring(res.Rarity),
	}, "|")
	if key == lastShownThrowResult and (now - lastShownThrowAt) < 1.5 then return end
	lastShownThrowResult, lastShownThrowAt = key, now
