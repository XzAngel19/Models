local function equipBestOnce()
	if equipState.busy then return false, "Equip Best is still running" end
	equipState.busy = true
	local ok, result = callRemote("Plot_EquipBest", false)
	equipState.busy = false
	equipState.lastAttemptAt = os.clock()
	if ok and type(result) == "table" and result.Ok == true then
		equipState.lastOkAt = os.clock()
		equipState.failures = 0
		equipState.lastPlaced = tonumber(result.Placed) or 0
		equipState.lastRemoved = tonumber(result.Removed) or 0
		return true, result
	end
	equipState.failures += 1
	return false, tostring(result)
end
