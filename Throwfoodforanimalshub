local function setAnimalEsp(enabled)
	cleanupAnimalEsp()
	if not enabled then return true end
	if game.PlaceId ~= GAME_PLACE_ID then return false, "Join Throw Food for Animals first" end
	local okEcon, econ = pcall(configModule, "AnimalEconomy")
	local okRarity, rarityCfg = pcall(configModule, "RarityConfig")
	local folder = Instance.new("Folder")
	folder.Name = "Hub_AnimalESP"
	folder.Parent = workspace
	animalEspFolder = folder

	local tagged = {}
	local function attach(obj)
		if tagged[obj] or not obj:IsDescendantOf(workspace) then return end
		local adornee = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)) or (obj:IsA("BasePart") and obj)
		if not adornee then return end
		tagged[obj] = true
		local modelName = obj:GetAttribute("ModelName") or obj.Name
		local mutation = obj:GetAttribute("Mutation")
		local info = okEcon and econ.Get(modelName)
		local col = (okRarity and info and info.Rarity and rarityCfg.Get(info.Rarity).Color) or Color3.fromRGB(220, 220, 235)

		local hl = Instance.new("Highlight")
		hl.Adornee = obj
		hl.FillColor = col
		hl.FillTransparency = 0.72
		hl.OutlineColor = col
		hl.OutlineTransparency = 0.1
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = folder

		local bb = Instance.new("BillboardGui")
		bb.Adornee = adornee
		bb.Size = UDim2.fromOffset(170, 24)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 220
		bb.Parent = folder
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.TextColor3 = col
		lbl.Font = BOLD_FONT
		lbl.TextSize = 13
		lbl.Text = (mutation and mutation ~= "" and (mutation .. " ") or "") .. tostring(modelName)
		lbl.Parent = bb
		local textStroke = Instance.new("UIStroke")
		textStroke.Color = Color3.new(0, 0, 0)
		textStroke.Thickness = 1.6
		textStroke.Transparency = 0.15
		textStroke.Parent = lbl

		obj.AncestryChanged:Connect(function(_, parent)
			if not parent then
				tagged[obj] = nil
				if hl.Parent then hl:Destroy() end
				if bb.Parent then bb:Destroy() end
			end
		end)
	end

	for _, tag in ipairs({ "PlotAnimal", "Animal" }) do
		for _, inst in ipairs(collectionService:GetTagged(tag)) do attach(inst) end
		table.insert(animalEspConns, collectionService:GetInstanceAddedSignal(tag):Connect(attach))
	end
	return true
end

